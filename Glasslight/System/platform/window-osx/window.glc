package window;
require core.basic ~> .;
require platform.cocoa ~> cocoa;

[[(:kind, :alias), (:alias, :weak)]] typecreate size_t ~> cocoa.ns_size_r;
[[(:kind, :alias), (:alias, :weak)]] typecreate rect_t ~> cocoa.ns_rect_r;
[[(:kind, :alias), (:alias, :weak)]] typecreate style_mask_t ~> cocoa.ns_window_style_mask_t;
[[(:kind, :alias), (:alias, :weak)]] typecreate window_t ~> cocoa.ns_window_t;

const style_mask_titled<style_mask_t> = cocoa.ns_window_style_mask_titled;
const style_mask_closable<style_mask_t> = cocoa.ns_window_style_mask_closable;
const style_mask_resizable<style_mask_t> = cocoa.ns_window_style_mask_resizable;

# Return the default titled, closable, resizable style mask.
+ default_style_mask -> style_mask_t
{
	^ style_mask_titled + style_mask_closable + style_mask_resizable;
}

# Build a platform window size.
+ make_size(width<f8>, height<f8>) -> size_t
{
	^ cocoa.make_ns_size(width, height);
}

# Build a platform window rect.
+ make_rect(x<f8>, y<f8>, width<f8>, height<f8>) -> rect_t
{
	^ cocoa.make_ns_rect(x, y, width, height);
}

# Create a titled platform window using the current Cocoa backend.
+ make_titled_window(content_rect<rect_t>, style_mask<style_mask_t>, title_text<[c1, :c]>) -> window_t
{
	^ cocoa.make_titled_window(content_rect, style_mask, title_text);
}

# Create a titled platform window using the default style mask.
+ make_default_window(content_rect<rect_t>, title_text<[c1, :c]>) -> window_t
{
	^ make_titled_window(content_rect, default_style_mask, title_text);
}

# Show the window and make it key.
+ show(window<window_t>) -> ()
{
	cocoa.make_key_and_order_front(window, nil);
	^ ();
}

# Close the window.
+ close(window<window_t>) -> ()
{
	cocoa.close(window);
	^ ();
}

# Set the content size of the window.
+ set_content_size(window<window_t>, size<size_t>) -> ()
{
	cocoa.set_content_size(window, size);
	^ ();
}

# Return the current content size of the window.
+ content_size(window<window_t>) -> size_t
{
	^ cocoa.content_size(window);
}

# Clear the recorded resize state for the reusable window delegate.
+ reset_resize_state -> ()
{
	cocoa.reset_resize_tracking_window_delegate_state;
	^ ();
}

# Return whether the reusable window delegate observed a resize.
+ did_resize? -> atom
{
	^ cocoa.resize_tracking_window_delegate_did_resize?;
}

# Return the latest size observed by the reusable window delegate.
+ latest_resize_size -> size_t
{
	^ cocoa.resize_tracking_window_delegate_latest_size;
}

# Clear the recorded close state for the reusable window delegate.
+ reset_close_state -> ()
{
	cocoa.reset_stop_on_close_window_delegate_state;
	^ ();
}

# Return whether the reusable window delegate observed a close.
+ did_close? -> atom
{
	^ cocoa.stop_on_close_window_delegate_did_close?;
}
