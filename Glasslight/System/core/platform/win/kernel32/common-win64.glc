package kernel32;
require core.basic ~> .;

# Win32 HANDLE type.
[[(:kind, :alias), (:alias, :weak)]] typecreate handle_t ~> voidptr;

# Standard device handles for GetStdHandle.
const STD_INPUT_HANDLE<u4>  = 0xFFFFFFF6_u4;
const STD_OUTPUT_HANDLE<u4> = 0xFFFFFFF5_u4;
const STD_ERROR_HANDLE<u4>  = 0xFFFFFFF4_u4;

# Return code from WaitForSingleObject indicating the handle was signaled.
const WAIT_OBJECT_0<u4> = 0_u4;

# Sentinel timeout for WaitForSingleObject meaning "wait forever".
const INFINITE<u4> = 0xFFFFFFFF_u4;

# Largest finite millisecond value that fits in a DWORD without aliasing
# INFINITE. Used by any Win32 API that takes a `DWORD dwMilliseconds`
# timeout (Sleep, SleepConditionVariableSRW, WaitForSingleObject, ...).
const MAX_FINITE_MS<s8> = 4294967294_s8;

# LPSYSTEM_INFO record matching Win32's SYSTEM_INFO layout (48 bytes on x64).
[[(:alignment, 8_sz)]]
record SYSTEM_INFO_r
{
	let wProcessorArchitecture<u2>;
	let wReserved<u2>;
	let dwPageSize<u4>;
	let lpMinimumApplicationAddress<voidptr>;
	let lpMaximumApplicationAddress<voidptr>;
	let dwActiveProcessorMask<size>;
	let dwNumberOfProcessors<u4>;
	let dwProcessorType<u4>;
	let dwAllocationGranularity<u4>;
	let wProcessorLevel<u2>;
	let wProcessorRevision<u2>;
}

enum win32_error_code_e : u4
{
	error_none                = 0_u4,
	error_file_not_found      = 2_u4,
	error_path_not_found      = 3_u4,
	error_access_denied       = 5_u4,
	error_invalid_handle      = 6_u4,
	error_not_enough_memory   = 8_u4,
	error_no_more_files       = 18_u4,
	error_handle_eof          = 38_u4,
	error_netname_deleted     = 64_u4,
	error_file_exists         = 80_u4,
	error_invalid_parameter   = 87_u4,
	error_broken_pipe         = 109_u4,
	error_buffer_overflow     = 111_u4,
	error_insufficient_buffer = 122_u4,
	error_mod_not_found       = 126_u4,
	error_proc_not_found      = 127_u4,
	error_dir_not_empty       = 145_u4,
	error_already_exists      = 183_u4,
	error_envvar_not_found    = 203_u4,
	error_more_data           = 234_u4,
	error_operation_aborted   = 995_u4,
	error_io_pending          = 997_u4,
	error_not_found           = 1168_u4,
	error_privilege_not_held  = 1314_u4
}
