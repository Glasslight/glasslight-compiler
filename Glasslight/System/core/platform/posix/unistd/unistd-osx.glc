package unistd;
require core.basic ~> basic;

# sysconf name for "number of processors currently online" on Darwin.
const SC_NPROCESSORS_ONLN<basic.s4> = 58_s4;

[[:system, :dynamic]]
foreign "libSystem.B.tbd" ~> .
{
	# Get current working directory (unistd.h).
	+ getcwd(buf<basic.c1*>, sz<basic.size>) -> [basic.c1, :c];

	# Write to a file descriptor (unistd.h).
	[[(:link_name, "write")]]
	+ write_fd(fd<basic.s4>, buf<basic.voidptr>, count<basic.size>) -> basic.s8;

	# Read from a file descriptor (unistd.h).
	[[(:link_name, "read")]]
	+ read_fd(fd<basic.s4>, buf<basic.voidptr>, count<basic.size>) -> basic.s8;

	# Close a file descriptor (unistd.h).
	[[(:link_name, "close")]]
	+ close_fd(fd<basic.s4>) -> basic.s4;

	# Query a numeric system configuration variable (unistd.h). Returns -1 on error.
	+ sysconf(name<basic.s4>) -> basic.s8;
}
