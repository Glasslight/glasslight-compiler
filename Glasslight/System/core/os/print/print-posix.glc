package print;
require core.common ~> .;
require core.os.handle ~> handle;
require core.string ~> .;
require core.platform.posix.unistd ~> posix_unistd;

+ write_handle(h<handle.handle_v>, text<[c1, :c]>) -> atom
{
	let (valid<atom>, fd<s4>) = handle.native_handle(h);
	if(!valid)
	{
		^ :false;
	}

	let remaining<size> = text.length();
	let ptr<c1*> = text ~~> c1*;

	while(remaining > 0_sz)
	{
		let written<s8> = posix_unistd.write_fd(fd, ptr ~~> voidptr, remaining);

		if(written <= 0_s8)
		{
			^ :false;
		}

		let advance<size> = (written ~> u8) ~~> size;
		ptr = ptr + advance;
		remaining -= advance;
	}

	^ :true;
}

+ print(text<[c1, :c]>) -> atom
{
	^ write_handle(handle.make_handle(posix_unistd.STDOUT_FILENO, :borrowed), text);
}

+ eprint(text<[c1, :c]>) -> atom
{
	^ write_handle(handle.make_handle(posix_unistd.STDERR_FILENO, :borrowed), text);
}
