package stack;
require core.common ~> .;
require core.array ~> .;
require core.archive ~> archive;
require core.io ~> io;

[[:collection, :viewable, :disposable]]
record stack_r<$t<typeid> >
{
	let buf<[t, :dynamic]>;

	# Archive stacks as their logical contents only: a size-prefixed dynamic array
	# of elements in bottom-to-top order. On read, the backing array is restored so
	# the last archived element remains the stack top.
	- serialize(ar<archive.archive_r*>) when serializeable?(t) -> io.io_error_e
	{
		if(archive.writer?(ar))
		{
			^ archive.serialize([t, :dynamic], ar, self.buf);
		}
		elif(archive.reader?(ar))
		{
			^ archive.serialize(t, ar, &self.buf);
		}

		^ :invalid_input;
	}
	- serialize(ar<archive.archive_r*>) -> io.io_error_e { ^ :invalid_input; }

	# Returns the current number of elements.
	- length -> size { ^ self.buf.length; }

	# Returns the current allocated capacity.
	- capacity -> size { ^ self.buf.capacity; }

	# Returns :true when empty and :false otherwise.
	- empty? -> atom { ^ self.buf.empty?; }

	# Pushes a value onto the top of the stack.
	- push!(value<t>) -> ()
	{
		self.buf.append!(value);
		^ ();
	}

	# Pop is a no-op when the stack is empty.
	- pop! when self.empty? -> () { ^ (); }
	- pop! -> ()
	{
		self.buf.pop!;
		^ ();
	}

	# Returns the top element.
	- top when self.empty? -> (atom, t)
	{
		let x<t>;
		^ (:false, x);
	}
	- top -> (atom, t) { ^ (:true, self.buf.top); }

	# Removes all elements but keeps allocation.
	- clear! -> ()
	{
		self.buf.clear!;
		^ ();
	}

	# Frees storage and resets the stack state.
	- delete -> ()
	{
		self.buf.delete;
		^ ();
	}

	# Disposes the owned element buffer (disposes disposable elements first).
	- dispose() -> ()
	{
		self.buf.dispose();
		^ ();
	}

	# Ensures capacity is at least new_cap.
	- reserve(new_cap<size>) -> ()
	{
		self.buf.reserve(new_cap);
		^ ();
	}

	# Shrinks capacity to fit the current number of elements.
	- shrink when self.buf.length == self.buf.capacity -> () { ^ (); }
	- shrink -> ()
	{
		self.buf.shrink;
		^ ();
	}

	# Return a view.
	- view -> [t, ()]
	{
		let v<[t, ()]> = self.buf.view;
		^ v;
	}
}

# Create a stack with initial capacity.
++ make_stack($t<typeid>, cap<size>) -> stack_r<t>
{
	let result<stack_r<t> >;
	result.buf = make_array(t, cap);

	^ result;
}

# Create a stack with default context and zero capacity.
++ make_stack($t<typeid>) -> stack_r<t>
{
	^ make_stack(t, 0_sz);
}

# Create a stack from a dynamic array (copies elements).
++ make_stack($t<typeid>, a<[t, :dynamic]>) -> stack_r<t>
{
	let result<stack_r<t> >;
	result.buf = copy_array(t, a);

	^ result;
}
