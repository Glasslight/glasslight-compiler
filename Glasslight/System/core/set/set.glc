package set;
require core.common ~> .;
require core.context ~> .;
require core.allocator ~> .;
require core.array ~> .;
require core.hash ~> .;
require core.mem ~> .;
require core.error ~> error;

# Node used in chained set implementation.
record set_node_r<$t<typeid> >
{
	let value<t>;
	let next_node<set_node_r<t>*> = nil;
}

# Round bucket count up to the next power of two, with a small minimum.
+ set_round_bucket_count(requested<size>) when requested <= 8_sz -> size { ^ 8_sz; }
+ set_round_bucket_count(requested<size>) -> size
{
	let count<size> = 8_sz;

	while(count < requested)
	{
		count *= 2_sz;
	}

	^ count;
}

# Map a value to a bucket index using the canonical hashing API.
+ set_bucket($t<typeid>, value<t>, count<size>) when hashable?(t) -> size
{
	let value_hash<hash> = hashing(value);
	^ (value_hash ~~> size) % count;
}

[[:collection]]
record set_r<$t<typeid> > when hashable?(t) && comparable?(t)
{
	let alloc<allocator_r>;
	let alloc_initialized<atom> = :false;
	let buckets<set_node_r<t>**> = nil;
	let bucket_count<size> = 0_sz;
	let length<size> = 0_sz;

	# Ensure this set has an allocator before allocating storage.
	- ensure_allocator! -> ()
	{
		if(!self.alloc_initialized)
		{
			let ctx<context_r> = get_default_ctx;
			self.alloc = ctx.main;
			self.alloc_initialized = :true;
		}

		^ ();
	}

	# Return the number of live elements.
	- length() -> size { ^ self.length; }

	# Return :true when this set has no live elements.
	- empty? -> atom { ^ self.length == 0_sz; }

	# Return the current bucket count.
	- capacity -> size { ^ self.bucket_count; }

	# Return a dynamic array snapshot of all live values, using this set's allocator.
	- array -> [t, :dynamic]
	{
		self.ensure_allocator!;

		let result<[t, :dynamic]>;
		result.alloc = self.alloc;
		result.reserve(self.length);

		for(let idx<size> = 0_sz; idx < self.bucket_count; idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(self.buckets + idx);

			while(!nil?(node))
			{
				result.append!(node.value);
				node = node.next_node;
			}
		}

		^ result;
	}

	# Find the node for a value, or nil when absent.
	- find_node(value<t>) when self.bucket_count == 0_sz -> set_node_r<t>* { ^ nil; }
	- find_node(value<t>) -> set_node_r<t>*
	{
		let idx<size> = set_bucket(value, self.bucket_count);
		let node<set_node_r<t>*> = *(self.buckets + idx);

		while(!nil?(node))
		{
			if(node.value == value)
			{
				^ node;
			}

			node = node.next_node;
		}

		^ nil;
	}

	# Rebuild the bucket array and relink all existing nodes.
	- rehash!(requested<size>) -> ()
	{
		let target<size> = set_round_bucket_count(requested);
		let bytes<size> = target * typeinfo(voidptr, :bytes);

		self.ensure_allocator!;

		let new_raw<voidptr> = allocator_alloc(self.alloc, bytes);

		if(nil?(new_raw))
		{
			error.runtime_error("set_r.rehash!: out of memory");
		}

		__glc_mem_set(new_raw, 0_u1, bytes);

		let old_buckets<set_node_r<t>**> = self.buckets;
		let old_bucket_count<size> = self.bucket_count;

		self.buckets = new_raw ~~> set_node_r<t>**;
		self.bucket_count = target;

		for(let old_idx<size> = 0_sz; old_idx < old_bucket_count; old_idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(old_buckets + old_idx);

			while(!nil?(node))
			{
				let next_link<set_node_r<t>*> = node.next_node;
				let new_idx<size> = set_bucket(node.value, self.bucket_count);
				node.next_node = *(self.buckets + new_idx);
				*(self.buckets + new_idx) = node;
				node = next_link;
			}
		}

		allocator_free(self.alloc, old_buckets ~~> voidptr);
		^ ();
	}

	# Ensure capacity for at least cap elements.
	- reserve!(cap<size>) when cap <= self.bucket_count -> () { ^ (); }
	- reserve!(cap<size>) -> ()
	{
		self.rehash!(cap);
		^ ();
	}

	# Insert a value. Returns :false when the value already exists.
	- add!(value<t>) -> atom
	{
		let existing<set_node_r<t>*> = self.find_node(value);

		if(!nil?(existing))
		{
			^ :false;
		}

		if(self.bucket_count == 0_sz)
		{
			self.rehash!(8_sz);
		}
		elif(self.length + 1_sz > self.bucket_count)
		{
			self.rehash!(self.bucket_count * 2_sz);
		}

		let raw<voidptr> = allocator_alloc(self.alloc, typeinfo(set_node_r<t>, :bytes));

		if(nil?(raw))
		{
			error.runtime_error("set_r.add!: out of memory");
		}

		let node<set_node_r<t>*> = raw ~~> set_node_r<t>*;
		let idx<size> = set_bucket(value, self.bucket_count);

		node.value = value;
		node.next_node = *(self.buckets + idx);
		*(self.buckets + idx) = node;
		self.length += 1_sz;

		^ :true;
	}

	# Return :true when this set contains value.
	- contains?(value<t>) -> atom
	{
		^ !nil?(self.find_node(value));
	}

	# Remove value if present. Returns :true when removed.
	- remove!(value<t>) when self.bucket_count == 0_sz -> atom { ^ :false; }
	- remove!(value<t>) -> atom
	{
		let idx<size> = set_bucket(value, self.bucket_count);
		let previous<set_node_r<t>*> = nil;
		let node<set_node_r<t>*> = *(self.buckets + idx);

		while(!nil?(node))
		{
			if(node.value == value)
			{
				if(nil?(previous))
				{
					*(self.buckets + idx) = node.next_node;
				}
				else
				{
					previous.next_node = node.next_node;
				}

				allocator_free(self.alloc, node ~~> voidptr);
				self.length -= 1_sz;

				^ :true;
			}

			previous = node;
			node = node.next_node;
		}

		^ :false;
	}

	# Remove value if present and run context-aware cleanup for the removed entry.
	- remove!(value<t>, cleanup<(context_r, t, voidptr) -> ()>, user_data<voidptr>) when self.bucket_count == 0_sz -> () { ^ (); }
	- remove!(value<t>, cleanup<(context_r, t, voidptr) -> ()>, user_data<voidptr>) -> ()
	{
		let idx<size> = set_bucket(value, self.bucket_count);
		let previous<set_node_r<t>*> = nil;
		let node<set_node_r<t>*> = *(self.buckets + idx);
		let ctx<context_r> = get_default_ctx;

		while(!nil?(node))
		{
			if(node.value == value)
			{
				if(nil?(previous))
				{
					*(self.buckets + idx) = node.next_node;
				}
				else
				{
					previous.next_node = node.next_node;
				}

				cleanup(node.value, user_data);
				allocator_free(self.alloc, node ~~> voidptr);
				self.length -= 1_sz;

				^ ();
			}

			previous = node;
			node = node.next_node;
		}

		^ ();
	}

	# Remove all entries while keeping bucket storage.
	- clear! -> ()
	{
		for(let idx<size> = 0_sz; idx < self.bucket_count; idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(self.buckets + idx);

			while(!nil?(node))
			{
				let next_link<set_node_r<t>*> = node.next_node;
				allocator_free(self.alloc, node ~~> voidptr);
				node = next_link;
			}

			*(self.buckets + idx) = nil;
		}

		self.length = 0_sz;
		^ ();
	}

	# Remove all entries with context-aware cleanup, while keeping bucket storage.
	- clear!(cleanup<(context_r, t, voidptr) -> ()>, user_data<voidptr>) -> ()
	{
		let ctx<context_r> = get_default_ctx;

		for(let idx<size> = 0_sz; idx < self.bucket_count; idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(self.buckets + idx);

			while(!nil?(node))
			{
				let next_link<set_node_r<t>*> = node.next_node;
				cleanup(node.value, user_data);
				allocator_free(self.alloc, node ~~> voidptr);
				node = next_link;
			}

			*(self.buckets + idx) = nil;
		}

		self.length = 0_sz;
		^ ();
	}

	# Release all storage and reset to zero-initialized state.
	- delete -> ()
	{
		if(self.alloc_initialized)
		{
			self.clear!;
			allocator_free(self.alloc, self.buckets ~~> voidptr);
		}

		self.buckets = nil;
		self.bucket_count = 0_sz;
		self.length = 0_sz;
		self.alloc_initialized = :false;

		let reset_alloc<allocator_r>;
		self.alloc = reset_alloc;

		^ ();
	}

	# Release all storage after running context-aware cleanup for each live entry.
	- delete(cleanup<(context_r, t, voidptr) -> ()>, user_data<voidptr>) -> ()
	{
		if(self.alloc_initialized)
		{
			self.clear!(cleanup, user_data);
			allocator_free(self.alloc, self.buckets ~~> voidptr);
		}

		self.buckets = nil;
		self.bucket_count = 0_sz;
		self.length = 0_sz;
		self.alloc_initialized = :false;

		let reset_alloc<allocator_r>;
		self.alloc = reset_alloc;

		^ ();
	}
}

# Create a chained set with requested capacity.
++ make_set_with_capacity($t<typeid>, cap<size>) when hashable?(t) && comparable?(t) -> [t, :set]
{
	let result<[t, :set]>;
	result.alloc = ctx.main;
	result.alloc_initialized = :true;

	if(cap > 0_sz)
	{
		result.reserve!(cap);
	}

	^ result;
}

# Create a chained set with allocator and requested capacity.
++ make_set($t<typeid>, alloc<allocator_r>, cap<size>) when hashable?(t) && comparable?(t) -> [t, :set]
{
	let result<[t, :set]>;
	result.alloc = alloc;
	result.alloc_initialized = :true;

	if(cap > 0_sz)
	{
		result.reserve!(cap);
	}

	^ result;
}

# Create a chained set.
++ make_set($t<typeid>) when hashable?(t) && comparable?(t) -> [t, :set]
{
	^ make_set_with_capacity(t, 0_sz);
}

# Create a chained set with allocator.
++ make_set($t<typeid>, alloc<allocator_r>) when hashable?(t) && comparable?(t) -> [t, :set]
{
	^ make_set(t, alloc, 0_sz);
}

# Return a fresh set containing every value in left or right.
++ set_union($t<typeid>, left<set_r<t> >, right<set_r<t> >) when hashable?(t) && comparable?(t) -> [t, :set]
{
	let result<[t, :set]> = make_set(t, ctx.main, left.length() + right.length());

	for(let idx<size> = 0_sz; idx < left.bucket_count; idx += 1_sz)
	{
		let node<set_node_r<t>*> = *(left.buckets + idx);

		while(!nil?(node))
		{
			result.add!(node.value);
			node = node.next_node;
		}
	}

	for(let idx<size> = 0_sz; idx < right.bucket_count; idx += 1_sz)
	{
		let node<set_node_r<t>*> = *(right.buckets + idx);

		while(!nil?(node))
		{
			result.add!(node.value);
			node = node.next_node;
		}
	}

	^ result;
}

# Return a fresh set containing values present in both inputs.
++ set_intersection($t<typeid>, left<set_r<t> >, right<set_r<t> >) when hashable?(t) && comparable?(t) -> [t, :set]
{
	let result<[t, :set]> = make_set(t, ctx.main, 0_sz);

	if(left.length() <= right.length())
	{
		result.reserve!(left.length());

		for(let idx<size> = 0_sz; idx < left.bucket_count; idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(left.buckets + idx);

			while(!nil?(node))
			{
				if(right.contains?(node.value))
				{
					result.add!(node.value);
				}

				node = node.next_node;
			}
		}
	}
	else
	{
		result.reserve!(right.length());

		for(let idx<size> = 0_sz; idx < right.bucket_count; idx += 1_sz)
		{
			let node<set_node_r<t>*> = *(right.buckets + idx);

			while(!nil?(node))
			{
				if(left.contains?(node.value))
				{
					result.add!(node.value);
				}

				node = node.next_node;
			}
		}
	}

	^ result;
}

# Return a fresh set containing values present in left but absent from right.
++ set_difference($t<typeid>, left<set_r<t> >, right<set_r<t> >) when hashable?(t) && comparable?(t) -> [t, :set]
{
	let result<[t, :set]> = make_set(t, ctx.main, left.length());

	for(let idx<size> = 0_sz; idx < left.bucket_count; idx += 1_sz)
	{
		let node<set_node_r<t>*> = *(left.buckets + idx);

		while(!nil?(node))
		{
			if(!right.contains?(node.value))
			{
				result.add!(node.value);
			}

			node = node.next_node;
		}
	}

	^ result;
}
