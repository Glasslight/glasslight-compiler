package archive;
require core.common ~> .;
require core.io ~> io;
require core.math ~> math;

# Return true when a type can be serialized through the archive path.
+ serializeable?($t<typeid>) when typeinfo(t, :serializable) -> atom { ^ :true; }
+ serializeable?($t<typeid>) -> atom { ^ :false; }

# Write a serializable value to the archive.
+ serialize($t<typeid>, ar<archive_r*>, value<t>) when serializeable?(t) && writer?(ar) -> io.io_error_e
{
	if(ar.err != :ok)
	{
		^ ar.err;
	}

	constif(record?(t))
	{
		^ value.serialize(ar);
	}
	elif(math.endian_swappable?(t))
	{
		let stored<t> = math.endian_swap(t, __glc_endianness, ar.endian, value);
		let ptr<u1*> = &stored ~~> u1*;
		^ set_error(ar, io.write_all(ar.writer, make_view(u1, ptr, typeinfo(t, :bytes))));
	}
	else
	{
		let stored<t> = value;
		let ptr<u1*> = &stored ~~> u1*;
		^ set_error(ar, io.write_all(ar.writer, make_view(u1, ptr, typeinfo(t, :bytes))));
	}
}
+ serialize($t<typeid>, ar<archive_r*>, value<t>) -> io.io_error_e
{
	^ set_error(ar, :invalid_input);
}

# Read a serializable value from the archive.
+ serialize($t<typeid>, ar<archive_r*>) when serializeable?(t) && reader?(ar) -> (io.io_error_e, t)
{
	let stored<t>;

	if(ar.err != :ok)
	{
		^ (ar.err, stored);
	}

	constif(record?(t))
	{
		let err<io.io_error_e> = stored.serialize(ar);
		^ (err, stored);
	}
	elif(math.endian_swappable?(t))
	{
		let ptr<u1*> = &stored ~~> u1*;
		let err<io.io_error_e> = set_error(ar, io.read_all(ar.reader, make_view(u1, ptr, typeinfo(t, :bytes))));

		if(err != :ok)
		{
			^ (err, stored);
		}

		stored = math.endian_swap(t, ar.endian, __glc_endianness, stored);
		^ (err, stored);
	}
	else
	{
		let ptr<u1*> = &stored ~~> u1*;
		let err<io.io_error_e> = set_error(ar, io.read_all(ar.reader, make_view(u1, ptr, typeinfo(t, :bytes))));
		^ (err, stored);
	}
}
+ serialize($t<typeid>, ar<archive_r*>) -> (io.io_error_e, t)
{
	let value<t>;
	^ (set_error(ar, :invalid_input), value);
}
