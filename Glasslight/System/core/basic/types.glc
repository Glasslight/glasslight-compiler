package basic;

# Internal structural types — behavior declarations only.
[[(:kind, :nil), (:compare, :value)]] typecreate _;
[[(:kind, :pointer), (:compare, :value)]] typecreate _;
[[(:kind, :function), (:compare, :value)]] typecreate _;
[[(:kind, :tuple), (:compare, :fields), (:order, :fields)]] typecreate _;
[[(:kind, :atomenum), (:compare, :value)]] typecreate _;

# Size type, 64 bit, unsigned.
[[(:kind, :size), (:suffix, :sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate size;

# Hash type, 64 bit, integral.
[[(:kind, :hash), (:suffix, :hs), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate hash;

# Entity handle type, 64 bit, opaque.
[[(:kind, :entity), :hashable, (:compare, :value)]] typecreate entity;

# Atom type, 64 bit, unsigned.
[[(:kind, :atom), :hashable, :serializeable, (:compare, :value)]] typecreate atom;

# Float types.
[[(:kind, :float), (:bits, 16_sz), :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate f2;
[[(:kind, :float), (:bits, 32_sz), :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate f4;
[[(:kind, :float), (:bits, 64_sz), :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate f8;

# Unsigned integers.
[[(:kind, :unsigned), (:bits, 8_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate u1;
[[(:kind, :unsigned), (:bits, 16_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate u2;
[[(:kind, :unsigned), (:bits, 32_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate u4;
[[(:kind, :unsigned), (:bits, 64_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate u8;

# Signed integers.
[[(:kind, :signed), (:bits, 8_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate s1;
[[(:kind, :signed), (:bits, 16_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate s2;
[[(:kind, :signed), (:bits, 32_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate s4;
[[(:kind, :signed), (:bits, 64_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate s8;

# Character types.
[[(:kind, :character), (:bits, 8_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate c1;
[[(:kind, :character), (:bits, 16_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate c2;
[[(:kind, :character), (:bits, 32_sz), :integral, :hashable, :serializeable, (:compare, :value), (:order, :value)]] typecreate c4;

# Vector types — half (f2) element.
[[(:kind, :vector), (:dim, 2_sz), (:element, :f2), :mixable, (:compare, :value)]] typecreate v2f2;
[[(:kind, :vector), (:dim, 3_sz), (:element, :f2), :mixable, (:compare, :value)]] typecreate v3f2;
[[(:kind, :vector), (:dim, 4_sz), (:element, :f2), :mixable, (:compare, :value)]] typecreate v4f2;

# Vector types — float (f4) element.
[[(:kind, :vector), (:dim, 2_sz), (:element, :f4), :mixable, (:compare, :value)]] typecreate v2f4;
[[(:kind, :vector), (:dim, 3_sz), (:element, :f4), :mixable, (:compare, :value)]] typecreate v3f4;
[[(:kind, :vector), (:dim, 4_sz), (:element, :f4), :mixable, (:compare, :value)]] typecreate v4f4;

# Vector types — double (f8) element.
[[(:kind, :vector), (:dim, 2_sz), (:element, :f8), :mixable, (:compare, :value)]] typecreate v2f8;
[[(:kind, :vector), (:dim, 3_sz), (:element, :f8), :mixable, (:compare, :value)]] typecreate v3f8;
[[(:kind, :vector), (:dim, 4_sz), (:element, :f8), :mixable, (:compare, :value)]] typecreate v4f8;

# Vector types — atom element.
[[(:kind, :vector), (:dim, 2_sz), (:element, :atom), :mixable, (:compare, :value)]] typecreate v2atom;
[[(:kind, :vector), (:dim, 3_sz), (:element, :atom), :mixable, (:compare, :value)]] typecreate v3atom;
[[(:kind, :vector), (:dim, 4_sz), (:element, :atom), :mixable, (:compare, :value)]] typecreate v4atom;

# C string literals - [c1, :c] resolves to cstring.
[[(:kind, :cstring), :mixable, (:compare, :value)]] typecreate cstring;

# Wide C string literals - [c2, :c] resolves to wcstring.
[[(:kind, :wcstring), :mixable, (:compare, :value)]] typecreate wcstring;

# Compile-time only/const string literal - [c1, :const] resolves to strlit.
[[(:kind, :strlit), :const_only]] typecreate strlit;

# Compile-time only/const wide string literal - [c2, :const] resolves to wstrlit.
[[(:kind, :wstrlit), :const_only]] typecreate wstrlit;

# Opaque (void*) type.
[[(:kind, :voidptr), :hashable, (:compare, :value)]] typecreate voidptr;

# Opaque function pointer type.
[[(:kind, :fptr), (:compare, :value)]] typecreate fptr;

# Type id handle.
[[(:kind, :typeid), :hashable, (:compare, :value)]] typecreate typeid;

# C atom type (64-bit hash) used by foreign functions.
[[(:kind, :foreignatom), :foreign]] typecreate catom;

# C boolean type used by foreign functions.
[[(:kind, :foreignbool), :foreign]] typecreate cbool;

# C void type used by foreign functions.
[[(:kind, :foreignvoid), :foreign]] typecreate cvoid;

# Base type for dynamic arrays — [T, :dynamic] resolves to dynamic_array_r<T>.
[[(:kind, :dynamic_array), (:record, :dynamic_array_r)]] typecreate _;

# Base type for stacks — [T, :stack] resolves to stack_r<T>.
[[(:kind, :stack), (:record, :stack_r)]] typecreate _;

# Base type for sets — [T, :set] resolves to set_r<T>.
[[(:kind, :set), (:record, :set_r)]] typecreate _;

# Base type for hashmaps — [K => V] resolves to hashmap_r<K, V>.
[[(:kind, :hashmap), (:record, :hashmap_r)]] typecreate _;

# Base type for static arrays — enables typemix methods on all [T, N] types.
[[(:kind, :static_array), :mixable, (:compare, :fields), (:order, :fields)]] typecreate static_array;

# Base type for unsized array views — [T, ()] resolves to view_r<T>.
[[(:kind, :view_unsized), (:record, :view_r)]] typecreate _;

# Base type for sized array views — [T, (N_sz,)] resolves to view_r<T, N>.
[[(:kind, :view_sized), (:record, :view_r)]] typecreate _;

# Base type for unsized mutable array views — [T, (), :mut] resolves to mut_view_r<T>.
[[(:kind, :view_unsized_mut), (:record, :mut_view_r)]] typecreate _;

# Base type for sized mutable array views — [T, (N_sz,), :mut] resolves to mut_view_r<T, N>.
[[(:kind, :view_sized_mut), (:record, :mut_view_r)]] typecreate _;

# Base type for strings — [c1] resolves to string_r.
[[(:kind, :string), (:record, :string_r)]] typecreate _;

# Base type for wide strings — [c2] resolves to wstring_r.
[[(:kind, :wstring), (:record, :wstring_r)]] typecreate _;

# Comparison mode for compare/order attributes.
atomenum type_compare_mode_e
{
	:value,		# Compare by the raw value (bitwise equality/ordering).
	:memory,	# Compare by raw memory representation.
	:fields,	# Compare field-by-field in declaration order.
	:view,		# Compare by content through the type's view (equality only).
	:none		# Explicitly not compare/order.
}

# Index mode for the (:index, mode) attribute. Every mode except :none
# includes value subscripting (a subscript getter).
atomenum type_index_mode_e
{
	:basic,				# Get only: subscript.
	:replace,			# Get + whole-element replacement: subscript_replace.
	:address,			# Get + element addressing: subscript_address.
	:replace_address,	# Get + replacement + addressing.
	:none				# Explicitly not indexable (same as no attribute).
}

# Comparison result atomenum for lexicographic ordering.
atomenum compare_result_e
{
	:less,
	:equal,
	:greater
}

# ABI kind atomenum for `typeinfo(..., :abi)`.
atomenum abi_e
{
	:c,
	:glc,
	:stdcall,
	:vectorcall
}

# Foreign library origin atomenum for `(:foreign_origin, ...)`.
atomenum foreign_origin_e
{
	:local,
	:system,
	:vendor,
	:builtin
}

# Foreign library linkage atomenum for `(:foreign_linkage, ...)`.
atomenum foreign_linkage_e
{
	:static,
	:dynamic,
	:runtime,
	:framework
}

# Type kind atomenum for `typeinfo(..., :kind)`.
atomenum typekind_e
{
	:signed,
	:unsigned,
	:float,
	:function,
	:character,
	:size,
	:hash,
	:entity,
	:pointer,
	:tuple,
	:record,
	:variant,
	:vector,
	:enum,
	:atom,
	:atomenum,
	:voidptr,
	:fptr,
	:typeid,
	:static_array,
	:dynamic_array,
	:stack,
	:view_unsized,
	:view_sized,
	:view_unsized_mut,
	:view_sized_mut,
	:cstring,
	:wcstring,
	:strlit,
	:wstrlit,
	:string,
	:wstring
}

# All keys accepted by the `typeinfo(T, :key)` builtin.
# Alphabetical order matches the user-facing "supported keys" error message in AstNodeTypeInfo.cpp.
atomenum typeinfo_key_e
{
	:abi,				# Callable ABI classification (abi_e).
	:alignment,			# Required byte alignment (size).
	:atomic,			# Type itself is atomic (atom).
	:bits,				# Bit width (size).
	:bytes,				# Size in bytes (size).
	:collection,		# Type is considered to be a collection (atom).
	:compare,			# Comparison mode (type_compare_mode_e).
	:contains_atomic,	# Has an atomic-typed field (atom).
	:contains_disposable,	# Transitively owns a :disposable value (atom).
	:dim,				# Vector component count (size).
	:disposable,		# Type carries the :disposable attribute (atom).
	:element,			# Element type of containers/vectors (typeid).
	:foreign,			# Foreign/FFI type (atom).
	:fragment,			# ECS fragment record marker (atom).
	:hashable,			# Supports hash metadata (atom).
	:immutable,			# Const-only type (atom).
	:index,				# Index mode (type_index_mode_e).
	:integral,			# Is an integer type (atom).
	:kind,				# Type kind classification (typekind_e).
	:length,			# Compile-time element count or string-literal length (size).
	:mixable,			# Participates in typemix expressions (atom).
	:order,				# Ordering mode (type_compare_mode_e).
	:phase,				# ECS phase record marker (atom).
	:processor,		# ECS processor record marker (atom).
	:serializeable,		# Supports archive serialization (atom).
	:stride,			# Element stride in bytes (size).
	:viewable			# Can produce an unsized view (atom).
}
