package basic;

# Return true if voidptr value is nil.
+ nil?(x<voidptr>) when x == nil -> atom { ^ :true; }
+ nil?(x<voidptr>) -> atom { ^ :false; }

# Return true if typed pointer value is nil.
+ nil?($t<typeid>, x<t*>) when nil?(x ~~> voidptr) -> atom { ^ :true; }
+ nil?($t<typeid>, x<t*>) -> atom { ^ :false; }

# Invalid size.
+ invalid_size -> size { ^ 0xffffffffffffffff_sz; }

# Invalid index.
+ invalid_index -> size { ^ invalid_size; }

# Return a length of a runtime-compatible value, or return invalid size if there's no length support.
+ length($t<typeid>) when tuple?(t) -> size { ^ typeinfo(t, :length); }
+ length($t<typeid>) when view_sized?(t) -> size { ^ typeinfo(t, :length); }
+ length($t<typeid>) when static_array?(t) -> size { ^ typeinfo(t, :length); }
+ length($t<typeid>) when vector?(t) -> size { ^ typeinfo(t, :length); }
+ length($t<typeid>) -> size { ^ invalid_size; }

+ length($x<[c1, :const]>) -> size { ^ typeinfo(x, :length); }
+ length($x<[c2, :const]>) -> size { ^ typeinfo(x, :length); }

+ length($t<typeid>, x<t>) when tuple?(t) -> size { ^ length(t); }
+ length($t<typeid>, x<t>) when view_sized?(t) -> size { ^ length(t); }
+ length($t<typeid>, x<t>) when static_array?(t) -> size { ^ length(t); }
+ length($t<typeid>, x<t>) when vector?(t) -> size { ^ length(t); }
+ length($t<typeid>, x<t>) when dynamic_array?(t) -> size { ^ x.length; }
+ length($t<typeid>, x<t>) when view_unsized?(t) -> size { ^ x.length; }
+ length($t<typeid>, x<t>) when stack?(t) -> size { ^ x.length; }
+ length($t<typeid>, x<t>) when string?(t) -> size { ^ x.length; }
+ length($t<typeid>, x<t>) when wstring?(t) -> size { ^ x.length; }
+ length($t<typeid>, x<t>) when cstring?(t) -> size { ^ x.length(); }
+ length($t<typeid>, x<t>) when wcstring?(t) -> size { ^ x.length(); }
+ length($t<typeid>, x<t>) -> size { ^ invalid_size; }

# Return true if length is zero.
+ empty?($t<typeid>) when tuple?(t) -> atom { ^ length(t) == 0_sz; }
+ empty?($t<typeid>) when view_sized?(t) -> atom { ^ length(t) == 0_sz; }
+ empty?($t<typeid>) when static_array?(t) -> atom { ^ length(t) == 0_sz; }
+ empty?($t<typeid>) when vector?(t) -> atom { ^ length(t) == 0_sz; }
+ empty?($t<typeid>) -> atom { ^ :false; }

+ empty?($x<[c1, :const]>) -> atom { ^ length(x) == 0_sz; }
+ empty?($x<[c2, :const]>) -> atom { ^ length(x) == 0_sz; }

+ empty?($t<typeid>, x<t>) when tuple?(t) -> atom { ^ empty?(t); }
+ empty?($t<typeid>, x<t>) when view_sized?(t) -> atom { ^ empty?(t); }
+ empty?($t<typeid>, x<t>) when static_array?(t) -> atom { ^ empty?(t); }
+ empty?($t<typeid>, x<t>) when vector?(t) -> atom { ^ empty?(t); }
+ empty?($t<typeid>, x<t>) when dynamic_array?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when view_unsized?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when stack?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when string?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when wstring?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when cstring?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) when wcstring?(t) -> atom { ^ x.empty?; }
+ empty?($t<typeid>, x<t>) -> atom { ^ :false; }

# Return true if two typeids reference the same type.
+ same_type?($a<typeid>, $b<typeid>) when a == b -> atom { ^ :true; }
+ same_type?($a<typeid>, $b<typeid>) -> atom { ^ :false; }

# Return the byte difference between two typed pointers (a - b) as a signed value.
+ byte_diff($t<typeid>, a<t*>, b<t*>) -> s8 { ^ (a ~~> s8) - (b ~~> s8); }

# Return the element difference between two typed pointers (a - b) as a signed value.
+ ptr_diff($t<typeid>, a<t*>, b<t*>) -> s8 { ^ ((a ~~> s8) - (b ~~> s8)) / (typeinfo(t, :bytes) ~~> s8); }

# Return the stride-based element difference between two typed pointers.
+ stride_diff($t<typeid>, a<t*>, b<t*>) -> s8 { ^ ((a ~~> s8) - (b ~~> s8)) / (typeinfo(t, :stride) ~~> s8); }

# Return type size in bits.
+ type_bits($t<typeid>) -> size { ^ typeinfo(t, :bits); }

# Return type size in bytes.
+ type_bytes($t<typeid>) -> size { ^ typeinfo(t, :bytes); }
