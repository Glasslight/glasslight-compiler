package basic;

# Returns the erased disposer for a type: a context-free (voidptr) -> ()
# function running the author's dispose, or nil for types with nothing to
# dispose. Captured at typed call sites (ecs fragment registration, push
# buffer records) and stored as data; dispose info enters a system at a
# value's first typed touch and flows with the bytes.
+ disposer_of($t<typeid>) when contains_disposable?(t) -> fptr
{
	let g<(voidptr) -> ()> = \ (p<voidptr>) -> ()
	{
		(p ~~> t*).dispose;
		^ ();
	};

	^ g ~> fptr;
}

+ disposer_of($t<typeid>) -> fptr
{
	let no_disposer<fptr>;
	^ no_disposer;
}
