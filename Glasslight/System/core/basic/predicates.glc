package basic;

# Return true if type is an atom type.
+ atom?($t<typeid>) when t == typeof atom -> atom { ^ :true; }
+ atom?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a size type.
+ size?($t<typeid>) when t == typeof size -> atom { ^ :true; }
+ size?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a hash type.
+ hash?($t<typeid>) when t == typeof hash -> atom { ^ :true; }
+ hash?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a character type.
+ character?($t<typeid>) when typeinfo(t, :kind) == :character -> atom { ^ :true; }
+ character?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a float type.
+ float?($t<typeid>) when typeinfo(t, :kind) == :float -> atom { ^ :true; }
+ float?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a signed type.
+ signed?($t<typeid>) when typeinfo(t, :kind) == :signed -> atom { ^ :true; }
+ signed?($t<typeid>) -> atom { ^ :false; }

# Return true if type is an unsigned type.
+ unsigned?($t<typeid>) when typeinfo(t, :kind) == :unsigned -> atom { ^ :true; }
+ unsigned?($t<typeid>) -> atom { ^ :false; }

# Return true if type is an integer type.
+ integer?($t<typeid>) when signed?(t) || unsigned?(t) || size?(t) || hash?(t) -> atom { ^ :true; }
+ integer?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a numeric type.
+ numeric?($t<typeid>) when float?(t) || integer?(t) -> atom { ^ :true; }
+ numeric?($t<typeid>) -> atom { ^ :false; }

# Return true if type is an empty tuple.
+ empty_tuple?($t<typeid>) when typeof () == t -> atom { ^ :true; }
+ empty_tuple?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a tuple.
+ tuple?($t<typeid>) when typeinfo(t, :kind) == :tuple -> atom { ^ :true; }
+ tuple?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a static array type.
+ static_array?($t<typeid>) when typeinfo(t, :kind) == :static_array -> atom { ^ :true; }
+ static_array?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a function.
+ function?($t<typeid>) when typeinfo(t, :kind) == :function -> atom { ^ :true; }
+ function?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a record type.
+ record?($t<typeid>) when typeinfo(t, :kind) == :record -> atom { ^ :true; }
+ record?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a typeid.
+ typeid?($t<typeid>) when typeinfo(t, :kind) == :typeid -> atom { ^ :true; }
+ typeid?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a managed/dynamic array.
+ dynamic_array?($t<typeid>) when typeinfo(t, :kind) == :dynamic_array -> atom { ^ :true; }
+ dynamic_array?($t<typeid>) -> atom { ^ :false; }

# Return true if type is an atomset.
+ atomset?($t<typeid>) when typeinfo(t, :kind) == :atomset -> atom { ^ :true; }
+ atomset?($t<typeid>) -> atom { ^ :false; }

# Return true if type is a stack.
+ stack?($t<typeid>) when typeinfo(t, :kind) == :stack -> atom { ^ :true; }
+ stack?($t<typeid>) -> atom { ^ :false; }

# Return true if the type is a view.
+ view?($t<typeid>) when typeinfo(t, :kind) == :view_unsized || typeinfo(t, :kind) == :view_sized -> atom { ^ true; }
+ view?($t<typeid>) -> atom { ^ :false; }

# Return true if the type is a string.
+ string?($t<typeid>) when typeinfo(t, :kind) == :string -> atom { ^ true; }
+ string?($t<typeid>) -> atom { ^ :false; }

# Return true if the type is a wstring.
+ wstring?($t<typeid>) when typeinfo(t, :kind) == :wstring -> atom { ^ true; }
+ wstring?($t<typeid>) -> atom { ^ :false; }

# Return true if type supports equality comparison.
+ comparable?($t<typeid>) when typeinfo(t, :compare) != :none -> atom { ^ :true; }
+ comparable?($t<typeid>) -> atom { ^ :false; }

# Return true if type supports relational ordering.
+ orderable?($t<typeid>) when typeinfo(t, :order) != :none -> atom { ^ :true; }
+ orderable?($t<typeid>) -> atom { ^ :false; }

# Return true if the type is atomic.
+ atomic?($t<typeid>) when typeinfo(t, :atomic) -> atom { ^ true; }
+ atomic?($t<typeid>) -> atom { ^ :false; }

# Return type size in bits.
+ type_bits($t<typeid>) -> size { ^ typeinfo(t, :bits); }

# Return type size in bytes.
+ type_bytes($t<typeid>) -> size { ^ typeinfo(t, :bytes); }
