package jobs;
require core.common ~> .;
require core.array ~> .;
require core.atomic ~> .;
require core.thread ~> .;
require core.concurrent.job_queue ~> .;
require core.error ~> error;

# The job pool: persistent workers draining a shared job_queue_r. The
# general dedicated-pool facility - applications create pools and hand
# them to task domains. The ratified usage model is ONE app-wide pool
# with the ECS as its dominant tenant and other systems injecting
# occasional batches; per-batch completion counters keep every consumer's
# barrier honest under that sharing.
#
# Contexts: each worker binds its OWN per-worker arena state to
# ctx.transient at bootstrap (the default __glc_init_ctx arena state is a
# GLOBAL - sharing it across threads would race). ctx.main stays the
# malloc-backed default: thread-safe, cross-thread-free-safe, the primary
# allocator throughout the codebase. The transient arena is exactly the
# temp-allocation lane: scratch dies at the owner-defined reset
# (reset_worker_arenas!, quiescent pools only); letting it escape into
# durable structures is the author's bug.
#
# Waiting: wait! drains the queue alongside the workers - a waiting
# thread executes whatever it pops (any batch's jobs - work is work)
# under ITS OWN context, then spin+yields on the batch counter. Because
# waiters drain, a job may itself submit a sub-batch and wait! on it
# without deadlocking the pool.

# The completion handle: one atomic counter, stamped into every job of
# the batch by submit_batch!. Counters are general completion tokens -
# an async operation can hold one that its continuation settles.
record batch_r
{
	# Atomic storage as plain u4 (records with atomic fields cannot move
	# by value); all access goes through counter_ptr.
	let remaining<u4> = 0_u4;

	- counter_ptr -> atomic_u4* { ^ &self.remaining ~~> atomic_u4*; }

	- done? -> atom
	{
		if(load(self.counter_ptr, :seq_cst) == 0_u4)
		{
			^ :true;
		}

		^ :false;
	}
}

# Per-worker bootstrap block: stable-addressed (the pool pre-sizes the
# array and never grows it - workers hold pointers into it for life).
record worker_boot_r
{
	let q<job_queue_r*> = nil;
	let arena<arena_allocator_state_r*> = nil;
	let name<[c1, :c]>;
}

[[:disposable]]
record job_pool_r
{
	let q<job_queue_r>;
	let workers<[thread_r, :dynamic]>;
	let boots<[worker_boot_r, :dynamic]>;
	let arenas<[arena_allocator_state_r, :dynamic]>;
	let worker_count<size> = 0_sz;

	# Stamps the batch's counter into every job, arms the counter, and
	# hands the batch to the queue. The jobs array is the caller's; its
	# counter fields are overwritten here.
	- submit_batch!(jobs<[job_r, :dynamic]*>, b<batch_r*>) -> ()
	{
		let n<size> = jobs.length;
		store(b.counter_ptr, (n ~~> u8) ~> u4, :seq_cst);

		for(let i<size> = 0_sz; i < n; i += 1_sz)
		{
			let cell<job_r*> = jobs.data() + i;
			cell.counter = b.counter_ptr;
		}

		self.q.submit_batch!(jobs.view);
		^ ();
	}

	# Resets every worker's transient arena. LEGAL ONLY AT POOL-LEVEL
	# QUIESCENCE (no jobs in flight anywhere - my barrier does not mean
	# your jobs finished): a shared pool's reset policy belongs to
	# whoever owns the sharing arrangement.
	- reset_worker_arenas! -> ()
	{
		for(let i<size> = 0_sz; i < self.arenas.length; i += 1_sz)
		{
			arena_allocator_reset!(self.arenas.data() + i);
		}

		^ ();
	}

	# Shuts the queue down, joins every worker, releases the arenas.
	- dispose -> ()
	{
		self.q.shutdown!;

		for(let i<size> = 0_sz; i < self.workers.length; i += 1_sz)
		{
			let joined<atom> = join(self.workers.at(i));
		}

		for(let i<size> = 0_sz; i < self.arenas.length; i += 1_sz)
		{
			arena_allocator_release!(self.arenas.data() + i);
		}

		self.workers.dispose;
		self.boots.dispose;
		self.arenas.dispose;
		self.q.dispose;
		^ ();
	}
}

# Runs one job under the ambient context and settles its counter - the
# executor contract, shared by workers and waiters.
++ run_job(j<job_r>) -> ()
{
	(j.fn ~> (context_r, voidptr) -> ())(j.data);

	if(!nil?(j.counter ~~> voidptr))
	{
		let left<u4> = fetch_sub(j.counter, 1_u4, :seq_cst);
	}

	^ ();
}

# Creates the pool in place (it embeds a mutex - it must not move):
# spawns worker_count named workers, each parked on the queue's blocking
# pop with its own transient arena bound. worker_count may be zero - all
# work is then done by whoever wait!s (the degenerate serial pool).
++ job_pool_init(p<job_pool_r*>, worker_count<size>, name<[c1, :c]>) -> ()
{
	job_queue_init(&p.q);
	p.worker_count = worker_count;
	p.workers = make_array(thread_r, worker_count);
	p.boots = make_array(worker_boot_r, worker_count);
	p.arenas = make_array(arena_allocator_state_r, worker_count);

	# Pre-size boots and arenas COMPLETELY before spawning anything -
	# workers hold pointers into these arrays, so they must never move.
	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let st<arena_allocator_state_r>;
		p.arenas.append!(st);
	}

	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let boot<worker_boot_r>;
		boot.q = &p.q;
		boot.arena = p.arenas.data() + i;
		boot.name = name;
		p.boots.append!(boot);
	}

	let worker_entry<(context_r, voidptr) -> ()> = \ (ctx<context_r>, user_data<voidptr>) -> ()
	{
		let boot<worker_boot_r*> = user_data ~~> worker_boot_r*;
		let named<atom> = thread_set_name(boot.name);

		# The landmine fix: bind THIS worker's transient to its own
		# pool-owned arena state, not the global one.
		ctx.transient = make_arena_allocator(boot.arena, make_default_allocator, 4096_sz);

		while(:true)
		{
			let (ok<atom>, j<job_r>) = boot.q.pop_blocking!;

			if(!ok)
			{
				break;
			}

			run_job(j);
		}

		^ ();
	};

	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let (spawned<atom>, t<thread_r>) = spawn_default(worker_entry, (p.boots.data() + i) ~~> voidptr);

		if(!spawned)
		{
			error.runtime_error("job_pool_r: worker spawn failed");
		}

		p.workers.append!(t);
	}

	^ ();
}

# The batch barrier: drains the queue alongside the workers (executing
# ANY batch's jobs under the caller's own context), then spin+yields on
# the counter for stragglers. Safe to call from inside a job - waiters
# make progress by draining.
++ wait!(p<job_pool_r*>, b<batch_r*>) -> ()
{
	while(!b.done?)
	{
		let (ok<atom>, j<job_r>) = p.q.try_pop!;

		if(ok)
		{
			run_job(j);
		}
		else
		{
			yield_now;
		}
	}

	^ ();
}
