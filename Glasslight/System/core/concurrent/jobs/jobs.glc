package jobs;
require core.common ~> .;
require core.array ~> .;
require core.atomic ~> .;
require core.thread ~> .;
require core.concurrent.job_queue ~> .;
require core.error ~> error;

# Job pool: persistent workers draining a shared job_queue_r. One app-wide
# pool, per-batch counters as barriers. ctx.main durable; ctx.transient is
# a per-worker arena, reset only at quiescence. wait! drains alongside the
# workers, so jobs may nest sub-batch waits without deadlock.

# The completion handle: one atomic counter, stamped into every job of
# the batch by submit_batch!.
record batch_r
{
	# Atomic storage as plain u4 (records with atomic fields cannot move
	# by value); all access goes through counter_ptr.
	let remaining<u4> = 0_u4;

	- counter_ptr -> atomic_u4* { ^ &self.remaining ~~> atomic_u4*; }

	- done? -> atom
	{
		if(load(self.counter_ptr, :seq_cst) == 0_u4)
		{
			^ :true;
		}

		^ :false;
	}
}

# Per-worker bootstrap block: stable-addressed (the pool pre-sizes the
# array and never grows it - workers hold pointers into it for life).
record worker_boot_r
{
	let q<job_queue_r*> = nil;
	let arena<arena_allocator_state_r*> = nil;
	let name<[c1, :c]>;
}

[[:disposable]]
record job_pool_r
{
	let q<job_queue_r>;
	let workers<[thread_r, :dynamic]>;
	let boots<[worker_boot_r, :dynamic]>;
	let arenas<[arena_allocator_state_r, :dynamic]>;
	let worker_count<size> = 0_sz;

	# Stamps and arms the batch's counter into every job, then hands the
	# batch to the queue.
	- submit_batch!(jobs<[job_r, :dynamic]*>, b<batch_r*>) -> ()
	{
		let n<size> = jobs.length;
		store(b.counter_ptr, (n ~~> u8) ~> u4, :seq_cst);

		for(let i<size> = 0_sz; i < n; i += 1_sz)
		{
			let cell<job_r*> = jobs.data() + i;
			cell.counter = b.counter_ptr;
		}

		self.q.submit_batch!(jobs.view);
		^ ();
	}

	# Resets every worker's transient arena. Legal only at pool-level
	# quiescence - a settled barrier does not mean the pool is idle.
	- reset_worker_arenas! -> ()
	{
		for(let i<size> = 0_sz; i < self.arenas.length; i += 1_sz)
		{
			arena_allocator_reset!(self.arenas.data() + i);
		}

		^ ();
	}

	# Shuts the queue down, joins every worker, releases the arenas.
	- dispose -> ()
	{
		self.q.shutdown!;

		for(let i<size> = 0_sz; i < self.workers.length; i += 1_sz)
		{
			let joined<atom> = join(self.workers.at(i));
		}

		for(let i<size> = 0_sz; i < self.arenas.length; i += 1_sz)
		{
			arena_allocator_release!(self.arenas.data() + i);
		}

		self.workers.dispose;
		self.boots.dispose;
		self.arenas.dispose;
		self.q.dispose;
		^ ();
	}
}

# Runs one job under the ambient context and settles its counter. Caller
# contract: the ambient ctx.transient must be thread-private.
++ run_job(j<job_r>) -> ()
{
	(j.fn ~> (context_r, voidptr) -> ())(j.data);

	if(!nil?(j.counter ~~> voidptr))
	{
		let left<u4> = fetch_sub(j.counter, 1_u4, :seq_cst);
	}

	^ ();
}

# Creates the pool in place (embeds a mutex - must not move). worker_count
# may be zero: all work is then done by whoever wait!s.
++ job_pool_init(p<job_pool_r*>, worker_count<size>, name<[c1, :c]>) -> ()
{
	job_queue_init(&p.q);
	p.worker_count = worker_count;
	p.workers = make_array(thread_r, worker_count);
	p.boots = make_array(worker_boot_r, worker_count);
	p.arenas = make_array(arena_allocator_state_r, worker_count);

	# Pre-size boots and arenas COMPLETELY before spawning anything -
	# workers hold pointers into these arrays, so they must never move.
	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let st<arena_allocator_state_r>;
		p.arenas.append!(st);
	}

	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let boot<worker_boot_r>;
		boot.q = &p.q;
		boot.arena = p.arenas.data() + i;
		boot.name = name;
		p.boots.append!(boot);
	}

	let worker_entry<(context_r, voidptr) -> ()> = \ (ctx<context_r>, user_data<voidptr>) -> ()
	{
		let boot<worker_boot_r*> = user_data ~~> worker_boot_r*;
		let named<atom> = thread_set_name(boot.name);

		# Per-worker transient arena. Copy ctx first - assignments on the
		# passed-in ctx do not thread to callees.
		let ctx<context_r> = ctx;
		ctx.transient = make_arena_allocator(boot.arena, make_default_allocator, 4096_sz);

		while(:true)
		{
			let (ok<atom>, j<job_r>) = boot.q.pop_blocking!;

			if(!ok)
			{
				break;
			}

			run_job(j);
		}

		^ ();
	};

	for(let i<size> = 0_sz; i < worker_count; i += 1_sz)
	{
		let (spawned<atom>, t<thread_r>) = spawn_default(worker_entry, (p.boots.data() + i) ~~> voidptr);

		# spawn_default reports :ok/:failed - both truthy; compare, never
		# truth-test status atoms.
		if(spawned != :ok)
		{
			error.runtime_error("job_pool_r: worker spawn failed");
		}

		p.workers.append!(t);
	}

	^ ();
}

# The batch barrier: drains the queue alongside the workers (any batch's
# jobs), then spin+yields on the counter. Safe to call from inside a job.
# Jobs drain under a wait-local arena - waiters must not share the global.
++ wait!(p<job_pool_r*>, b<batch_r*>) -> ()
{
	let wait_arena<arena_allocator_state_r>;

	# Copy ctx - assignments on the passed-in ctx do not thread to callees.
	let ctx<context_r> = ctx;
	ctx.transient = make_arena_allocator(&wait_arena, make_default_allocator, 4096_sz);

	while(!b.done?)
	{
		let (ok<atom>, j<job_r>) = p.q.try_pop!;

		if(ok)
		{
			run_job(j);
		}
		else
		{
			yield_now;
		}
	}

	arena_allocator_release!(&wait_arena);
	^ ();
}
