package ecs;
require core.common ~> .;
require core.context ~> .;
require core.builtin ~> .;

# The per-chunk execution context handed to a processor body, by value. A
# chunk is one archetype's live rows; the entities view's length is the row
# count. The ctx and every view it hands out are BORROWS into the archetype -
# invalidated by any structural change (bodies do not structurally mutate;
# deferred commands are a later slice).
#
# The ctx field carries the ticking caller's context. Execute bodies run
# context-free; one that needs context (allocation, formatting) enters it
# by introducing the binding:
#
#   - execute(ectx<exec_ctx_r>) -> ()
#   {
#       let ctx<context_r> = ectx.ctx;
#       ...
#   }
record exec_ctx_r
{
	let dt<f4> = 0.0_f4;
	let entities<[entity, ()]>;
	let arch<archetype_r*> = nil;
	let ctx<context_r>;

	# Access validation: the tick stamps the serving processor's query row
	# and flips checked, and read/write then verify - in checked builds
	# (__glc_ecs_checks, constif so disabled builds compile the gate out) -
	# that the body stays within its declared access. The schedule's
	# conflict guarantee is computed from those declarations; an undeclared
	# access would void it silently. Hand-built chunks leave checked off
	# and run unchecked.
	let info<processor_info_r>;
	let checked<atom> = :false;

	# Returns the chunk's row count.
	- length -> size { ^ self.entities.length(); }

	# Read-only view over one fragment column's live rows. Declaring a
	# write grants read (the query's write access subsumes it).
	- read($t<typeid>) when fragment?(t) -> [t, ()]
	{
		constif(__glc_ecs_checks)
		{
			let tid<typeid> = t;
			if(self.checked && !contains_tid?(self.info.reads, tid) && !contains_tid?(self.info.writes, tid))
			{
				error.runtime_error("ecs: read of a fragment the processor's query does not declare");
			}
		}

		^ make_view(t, self.arch.column_base(t) ~~> t*, self.arch.length);
	}

	# Mutable view over one fragment column's live rows: subscripts are
	# lvalues (writes are raw stores; the archetype owns element lifecycle).
	- write($t<typeid>) when fragment?(t) -> [t, (), :mut]
	{
		constif(__glc_ecs_checks)
		{
			let tid<typeid> = t;
			if(self.checked && !contains_tid?(self.info.writes, tid))
			{
				error.runtime_error("ecs: write of a fragment the processor's query does not declare");
			}
		}

		^ make_mut_view(t, self.arch.column_base(t) ~~> t*, self.arch.length);
	}
}

# True when the typeid list contains tid.
+ contains_tid?(list<[typeid, ()]>, tid<typeid>) -> atom
{
	for(let i<size> = 0_sz; i < list.length(); i += 1_sz)
	{
		if(list.at(i) == tid)
		{
			^ :true;
		}
	}

	^ :false;
}
