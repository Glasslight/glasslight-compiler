package ecs;
require core.common ~> .;
require core.array ~> .;
require core.string ~> .;
require core.hashmap ~> .;
require core.pushbuffer ~> .;
require core.builtin ~> .;
require core.error ~> error;

# The world: the entity registry + the archetype list + composition lookup.
# Archetype identity is the sorted fragment typeid set plus the sorted tag
# typeid set (tags are [[:tag]] record types); archetype index 0 is always
# the empty archetype (no fragment columns), where every spawned entity
# starts. Lookup goes through the composition-key hashmap: the key is the
# sorted fragment tid bytes, a separator, and the sorted tag tid bytes -
# exact equality, hashable, and the map owns the inserted keys (pass-2
# hashmap semantics).
#
# Ownership across transitions: cells are byte-copied to the target archetype
# and the old row is removed WITHOUT disposal (swap_remove_no_dispose!) -
# ownership moves with the bytes. remove! disposes the discarded fragment
# (return would transfer; discard disposes). destroy! uses the disposing
# swap_remove!. New fragment schema rows capture disposer_of(t) at the typed
# add! site; rows copy between archetypes, so dispose info flows as data.
[[:disposable]]
record world_r
{
	let registry<entity_registry_r>;
	let archetypes<[archetype_r, :dynamic]>;
	let tids_by_arch<[[typeid, :dynamic], :dynamic]>;
	let archetype_map<[[c1] => u4]>;

	# The world's allocator, captured from the creating context - the same
	# source the archetypes draw from.
	let alloc<allocator_r>;

	# The deferred structural command stream (see commands.glc): recorded
	# through exec_ctx_r during a tick, replayed by flush_commands! at band
	# boundaries and tick end. One buffer, reused across ticks - recording
	# is allocation-free once capacity settles.
	let commands<push_buffer_r>;

	# :true while a tick runs. Under checks, direct structural verbs abort
	# mid-tick (the chunk's views are borrows; the deferred verbs exist for
	# this); the flush suspends the flag for its own replay.
	let in_tick<atom> = :false;

	# Per-world processor instance block the compiler-emitted seams operate
	# on; allocated aligned from the world's allocator. Nil when the
	# program has no processors or ECS processing is suppressed.
	let processor_instances<voidptr> = nil;

	# Returns the number of live entities.
	- live_count -> size { ^ self.registry.live_count; }

	# Returns the number of archetypes (including the empty archetype).
	- archetype_count -> size { ^ self.archetypes.length; }

	# Pointer to an archetype by index. Invalidated when the archetype list
	# grows - re-take after any find_or_create!.
	- arch_at(ai<u4>) -> archetype_r*
	{
		^ self.archetypes.data() + (ai ~> u8 ~~> size);
	}

	# Appends a raw 64-bit value to a key as 8 bytes.
	+ append_raw(key<[c1]*>, raw<u8>) -> ()
	{
		for(let shift<size> = 0_sz; shift < 64_sz; shift += 8_sz)
		{
			key.append!(((raw >> shift) & 0xFF_u8) ~> u1 ~~> c1);
		}

		^ ();
	}

	# Canonical composition key: sorted tid bytes, a separator, sorted tag bytes.
	+ encode_key(tids<[typeid, ()]>, tags<[typeid, ()]>) -> [c1]
	{
		let key<[c1]> = make_string((tids.length() + tags.length() + 1_sz) * 8_sz);

		for(let i<size> = 0_sz; i < tids.length(); i += 1_sz)
		{
			world_r.append_raw(&key, tids.at(i) ~~> u8);
		}

		key.append!('|'_c1);

		for(let i<size> = 0_sz; i < tags.length(); i += 1_sz)
		{
			world_r.append_raw(&key, tags.at(i) ~~> u8);
		}

		^ key;
	}

	# Inserts a tid keeping the list sorted by raw value.
	+ sorted_insert_tid(list<[typeid, :dynamic]*>, tid<typeid>) -> ()
	{
		let pos<size> = 0_sz;

		while(pos < list.length && ((list.at(pos) ~~> u8) < (tid ~~> u8)))
		{
			pos += 1_sz;
		}

		list.insert_at!(tid, pos);
		^ ();
	}

	# Owned copy of an archetype's sorted tid list, optionally dropping one tid.
	- copy_tids(ai<u4>) -> [typeid, :dynamic]
	{
		let src<[typeid, :dynamic]*> = self.tids_by_arch.data() + (ai ~> u8 ~~> size);
		let result<[typeid, :dynamic]> = make_array(typeid, src.length);
		result.append!(src.view);
		^ result;
	}

	- copy_tids_without(ai<u4>, dropped<typeid>) -> [typeid, :dynamic]
	{
		let src<[typeid, :dynamic]*> = self.tids_by_arch.data() + (ai ~> u8 ~~> size);
		let result<[typeid, :dynamic]> = make_array(typeid, src.length);

		for(let i<size> = 0_sz; i < src.length; i += 1_sz)
		{
			if(!(src.at(i) == dropped))
			{
				result.append!(src.at(i));
			}
		}

		^ result;
	}

	# Owned copy of an archetype's sorted tag list, optionally dropping one tag.
	- copy_tags(ai<u4>) -> [typeid, :dynamic]
	{
		let arch<archetype_r*> = self.arch_at(ai);
		let result<[typeid, :dynamic]> = make_array(typeid, arch.tags.length);
		result.append!(arch.tags.view);
		^ result;
	}

	- copy_tags_without(ai<u4>, dropped<typeid>) -> [typeid, :dynamic]
	{
		let arch<archetype_r*> = self.arch_at(ai);
		let result<[typeid, :dynamic]> = make_array(typeid, arch.tags.length);

		for(let i<size> = 0_sz; i < arch.tags.length; i += 1_sz)
		{
			if(!(arch.tags.at(i) == dropped))
			{
				result.append!(arch.tags.at(i));
			}
		}

		^ result;
	}

	# Finds the archetype for a composition, creating it from the schema when
	# new. Takes ownership of tids and tags (stored on create, disposed on hit).
	- find_or_create!(tids<[typeid, :dynamic]>, tags<[typeid, :dynamic]>, schema<[fragment_info_r, ()]>) -> u4
	{
		let key<[c1]> = world_r.encode_key(tids.view, tags.view);
		let (found<atom>, existing<u4>) = self.archetype_map.get(key);

		if(found)
		{
			key.dispose;
			tids.dispose;
			tags.dispose;
			^ existing;
		}

		let arch<archetype_r> = make_archetype(schema);
		arch.tag_mask = tag_mask_of(tags.view);
		arch.tags = tags;
		let new_ai<u4> = self.archetypes.length ~~> u8 ~> u4;
		self.archetypes.append!(arch);
		self.tids_by_arch.append!(tids);
		self.archetype_map.set!(key, new_ai);

		^ new_ai;
	}

	# Removes a migrated-out row from its old archetype and fixes up the
	# swapped-in survivor's location.
	- remove_old_row!(old_ai<u4>, old_row<u4>) -> ()
	{
		let old<archetype_r*> = self.arch_at(old_ai);
		let row_sz<size> = old_row ~> u8 ~~> size;
		let last<size> = old.length - 1_sz;

		if(row_sz != last)
		{
			let moved<entity> = old.entity_at(last);
			old.swap_remove_no_dispose!(row_sz);
			self.registry.set_location!(moved, old_ai, old_row);
		}
		else
		{
			old.swap_remove_no_dispose!(row_sz);
		}

		^ ();
	}

	# Under checks: aborts on a direct structural change mid-tick. Compiled
	# out entirely when checks are off.
	- check_structural_ok -> ()
	{
		constif(__glc_ecs_checks)
		{
			if(self.in_tick)
			{
				error.runtime_error("ecs: direct structural change during a tick - record through the chunk's deferred verbs");
			}
		}

		^ ();
	}

	# Creates an entity in the empty archetype.
	- spawn! -> entity
	{
		self.check_structural_ok;
		let e<entity> = self.registry.spawn!;
		let empty<archetype_r*> = self.arch_at(0_u4);
		let row<size> = empty.reserve_row!;
		empty.write_entity(row, e);
		self.registry.set_location!(e, 0_u4, row ~~> u8 ~> u4);
		^ e;
	}

	# Allocates an entity handle WITHOUT placing it in any archetype - the
	# deferred-spawn primitive. The handle is valid immediately (commands
	# can be recorded against it), queries answer :false, and structural
	# verbs no-op until place_reserved! runs at flush.
	- reserve! -> entity { ^ self.registry.reserve!; }

	# Returns :true when the handle is a live reservation awaiting placement.
	- reserved?(e<entity>) -> atom { ^ self.registry.reserved?(e); }

	# Places a reserved entity into the empty archetype, making it a normal
	# live entity - the flush-time completion of a deferred spawn. Placing
	# a non-reserved or dead handle is a no-op returning :false.
	- place_reserved!(e<entity>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.reserved?(e))
		{
			^ :false;
		}

		let empty<archetype_r*> = self.arch_at(0_u4);
		let row<size> = empty.reserve_row!;
		empty.write_entity(row, e);
		self.registry.set_location!(e, 0_u4, row ~~> u8 ~> u4);
		^ :true;
	}

	# Destroys an entity: its fragments DIE - the disposing removal runs their
	# dispose - and the handle goes stale. Invalid/stale handles are a no-op.
	- destroy!(e<entity>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.valid?(e))
		{
			^ :false;
		}

		# A reserved entity has no archetype row - retiring the handle is
		# the whole job (a cancelled deferred spawn).
		if(self.registry.reserved?(e))
		{
			^ self.registry.destroy!(e);
		}

		let (ai<u4>, row<u4>) = self.registry.location(e);
		let arch<archetype_r*> = self.arch_at(ai);
		let row_sz<size> = row ~> u8 ~~> size;
		let last<size> = arch.length - 1_sz;

		if(row_sz != last)
		{
			let moved<entity> = arch.entity_at(last);
			arch.swap_remove!(row_sz);
			self.registry.set_location!(moved, ai, row);
		}
		else
		{
			arch.swap_remove!(row_sz);
		}

		self.registry.destroy!(e);
		^ :true;
	}

	# Runtime-typed add core: migrates the entity to the archetype with its
	# current composition plus tid, copying the fragment bytes in. The
	# fragment's layout and disposer arrive as data - the command buffer
	# carries them from the typed record site to the flush. Ownership of the
	# bytes transfers on :true; on :false the caller still owns them. Adding
	# a fragment the entity already has is a caller bug and aborts.
	- add_raw!(e<entity>, tid<typeid>, bytes<voidptr>, size<size>, align<size>, disposer<fptr>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let (old_ai<u4>, old_row<u4>) = self.registry.location(e);

		if(self.arch_at(old_ai).has_index?(tid))
		{
			error.runtime_error("world_r.add!: fragment already present");
		}

		let tids<[typeid, :dynamic]> = self.copy_tids(old_ai);
		world_r.sorted_insert_tid(&tids, tid);
		let tags<[typeid, :dynamic]> = self.copy_tags(old_ai);

		# Target schema: old rows (carrying their dispose pointers) + the new
		# fragment's row, in tid order.
		let schema<[fragment_info_r, :dynamic]> = make_array(fragment_info_r, tids.length);

		for(let i<size> = 0_sz; i < tids.length; i += 1_sz)
		{
			let row_tid<typeid> = tids.at(i);

			if(row_tid == tid)
			{
				let info<fragment_info_r>;
				info.tid = tid;
				info.size = size;
				info.align = align;
				info.dispose = disposer;
				schema.append!(info);
			}
			else
			{
				let old<archetype_r*> = self.arch_at(old_ai);
				schema.append!(old.infos.at(old.column_index(row_tid)));
			}
		}

		let target_ai<u4> = self.find_or_create!(tids, tags, schema.view);
		schema.dispose;

		# find_or_create! may have grown the archetype list - re-take pointers.
		let target<archetype_r*> = self.arch_at(target_ai);
		let old<archetype_r*> = self.arch_at(old_ai);
		let old_row_sz<size> = old_row ~> u8 ~~> size;

		let dst_row<size> = target.reserve_row!;

		for(let i<size> = 0_sz; i < old.infos.length; i += 1_sz)
		{
			let row_tid<typeid> = old.infos.at(i).tid;
			target.write_cell(row_tid, dst_row, old.cell_ptr_at(i, old_row_sz));
		}

		target.write_cell(tid, dst_row, bytes);
		target.write_entity(dst_row, e);
		self.registry.set_location!(e, target_ai, dst_row ~~> u8 ~> u4);

		self.remove_old_row!(old_ai, old_row);
		^ :true;
	}

	# Adds a fragment: sugar over add_raw! - the typed call site is the
	# birth point where layout and disposer are captured. The value's
	# ownership transfers to the world (the caller treats it as consumed).
	- add!(e<entity>, $t<typeid>, value<t>) -> atom
	{
		let v<t> = value;
		^ self.add_raw!(e, t, &v ~~> voidptr, typeinfo(t, :bytes), typeinfo(t, :alignment), disposer_of(t));
	}

	# Runtime-typed remove core: the entity migrates to the archetype
	# without tid, and the discarded fragment is DISPOSED via its schema
	# row's captured disposer (return would transfer; discard disposes).
	# Removing an absent fragment is a no-op returning :false.
	- remove_tid!(e<entity>, tid<typeid>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let (old_ai<u4>, old_row<u4>) = self.registry.location(e);
		let old_row_sz<size> = old_row ~> u8 ~~> size;

		if(!self.arch_at(old_ai).has_index?(tid))
		{
			^ :false;
		}

		let old_src<archetype_r*> = self.arch_at(old_ai);
		let col<size> = old_src.column_index(tid);
		let row_dispose<fptr> = old_src.infos.at(col).dispose;

		if(!nil?(row_dispose ~~> voidptr))
		{
			(row_dispose ~> (voidptr) -> ())(old_src.cell_ptr_at(col, old_row_sz));
		}

		let tids<[typeid, :dynamic]> = self.copy_tids_without(old_ai, tid);
		let tags<[typeid, :dynamic]> = self.copy_tags(old_ai);

		let schema<[fragment_info_r, :dynamic]> = make_array(fragment_info_r, tids.length);

		for(let i<size> = 0_sz; i < old_src.infos.length; i += 1_sz)
		{
			if(!(old_src.infos.at(i).tid == tid))
			{
				schema.append!(old_src.infos.at(i));
			}
		}

		let target_ai<u4> = self.find_or_create!(tids, tags, schema.view);
		schema.dispose;

		let target<archetype_r*> = self.arch_at(target_ai);
		let old<archetype_r*> = self.arch_at(old_ai);

		let dst_row<size> = target.reserve_row!;

		for(let i<size> = 0_sz; i < old.infos.length; i += 1_sz)
		{
			let row_tid<typeid> = old.infos.at(i).tid;

			if(!(row_tid == tid))
			{
				target.write_cell(row_tid, dst_row, old.cell_ptr_at(i, old_row_sz));
			}
		}

		target.write_entity(dst_row, e);
		self.registry.set_location!(e, target_ai, dst_row ~~> u8 ~> u4);

		self.remove_old_row!(old_ai, old_row);
		^ :true;
	}

	# Removes a fragment: sugar over remove_tid!.
	- remove!(e<entity>, $t<typeid>) -> atom
	{
		^ self.remove_tid!(e, t);
	}

	# Shared tag/untag migration: all fragments copy across; only the tag set
	# changes. Takes ownership of the new tag list.
	- retag!(e<entity>, old_ai<u4>, old_row<u4>, tags<[typeid, :dynamic]>) -> ()
	{
		let tids<[typeid, :dynamic]> = self.copy_tids(old_ai);
		let target_ai<u4> = self.find_or_create!(tids, tags, self.arch_at(old_ai).infos.view);

		let target<archetype_r*> = self.arch_at(target_ai);
		let old<archetype_r*> = self.arch_at(old_ai);
		let old_row_sz<size> = old_row ~> u8 ~~> size;

		let dst_row<size> = target.reserve_row!;

		for(let i<size> = 0_sz; i < old.infos.length; i += 1_sz)
		{
			target.write_cell(old.infos.at(i).tid, dst_row, old.cell_ptr_at(i, old_row_sz));
		}

		target.write_entity(dst_row, e);
		self.registry.set_location!(e, target_ai, dst_row ~~> u8 ~> u4);

		self.remove_old_row!(old_ai, old_row);
		^ ();
	}

	# Runtime-typed tag core (an archetype transition - tags are part of
	# archetype identity). The tid must name a [[:tag]] record type - typed
	# call sites guarantee it. Tagging an already-tagged entity is a no-op
	# returning :false.
	- tag_tid!(e<entity>, tag_tid<typeid>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let (old_ai<u4>, old_row<u4>) = self.registry.location(e);

		if(self.arch_at(old_ai).has_tag_tid?(tag_tid))
		{
			^ :false;
		}

		let tags<[typeid, :dynamic]> = self.copy_tags(old_ai);
		world_r.sorted_insert_tid(&tags, tag_tid);
		self.retag!(e, old_ai, old_row, tags);
		^ :true;
	}

	# Adds a tag: sugar over tag_tid!.
	- tag!(e<entity>, $t<typeid>) when tag?(t) -> atom
	{
		^ self.tag_tid!(e, t);
	}

	# Runtime-typed untag core. Untagging an untagged entity is a no-op
	# returning :false.
	- untag_tid!(e<entity>, tag_tid<typeid>) -> atom
	{
		self.check_structural_ok;

		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let (old_ai<u4>, old_row<u4>) = self.registry.location(e);

		if(!self.arch_at(old_ai).has_tag_tid?(tag_tid))
		{
			^ :false;
		}

		let tags<[typeid, :dynamic]> = self.copy_tags_without(old_ai, tag_tid);
		self.retag!(e, old_ai, old_row, tags);
		^ :true;
	}

	# Removes a tag: sugar over untag_tid!.
	- untag!(e<entity>, $t<typeid>) when tag?(t) -> atom
	{
		^ self.untag_tid!(e, t);
	}

	# Returns :true when the entity is live and has the fragment.
	- has?(e<entity>, $t<typeid>) -> atom
	{
		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let (ai<u4>, _<u4>) = self.registry.location(e);
		let tid<typeid> = t;
		^ self.arch_at(ai).has_index?(tid);
	}

	# Returns :true when the entity is live and carries the tag type.
	- has_tag?(e<entity>, $t<typeid>) when tag?(t) -> atom
	{
		if(!self.registry.valid?(e) || self.registry.reserved?(e))
		{
			^ :false;
		}

		let tag_tid<typeid> = t;
		let (ai<u4>, _<u4>) = self.registry.location(e);
		^ self.arch_at(ai).has_tag_tid?(tag_tid);
	}

	# Typed pointer to one entity's fragment - a BORROW, invalidated by the
	# next structural change (add/remove/tag/untag/destroy on any entity of the
	# same archetype, or archetype growth). Precondition: has?(e, t).
	- get(e<entity>, $t<typeid>) -> t*
	{
		let (ai<u4>, row<u4>) = self.registry.location(e);
		^ self.arch_at(ai).cell_ptr(t, row ~> u8 ~~> size) ~~> t*;
	}

	# Replays and clears the deferred command stream - the band-boundary
	# flush. Commands apply in record order (FIFO). Stale-handle policy:
	# shipping no-ops (a no-op'd add's payload is disposed here - the flush
	# owns consumed records); under checks, a data-losing command against a
	# dead entity aborts (spawn and destroy stay silent - a cancelled
	# reservation and an already-dead target lose nothing).
	- flush_commands! -> ()
	{
		# The flush is the sanctioned mutation window - suspend the
		# mid-tick guard for the replay.
		let was_in_tick<atom> = self.in_tick;
		self.in_tick = :false;

		while(self.commands.advance!)
		{
			if(self.commands.tag == :ecs_spawn)
			{
				let placed<atom> = self.place_reserved!((self.commands.payload ~~> cmd_entity_r*).e);
			}
			elif(self.commands.tag == :ecs_destroy)
			{
				let destroyed<atom> = self.destroy!((self.commands.payload ~~> cmd_entity_r*).e);
			}
			elif(self.commands.tag == :ecs_add)
			{
				let hdr<cmd_add_r*> = self.commands.payload ~~> cmd_add_r*;

				constif(__glc_ecs_checks)
				{
					if(!self.registry.valid?(hdr.e))
					{
						error.runtime_error("ecs: deferred add! targets a dead entity");
					}
				}

				let frag<voidptr> = ((self.commands.payload ~~> u8) + (add_fragment_offset(hdr.falign) ~~> u8)) ~~> voidptr;

				if(!self.add_raw!(hdr.e, hdr.tid, frag, hdr.fsize, hdr.falign, hdr.fdisposer))
				{
					if(!nil?(hdr.fdisposer ~~> voidptr))
					{
						(hdr.fdisposer ~> (voidptr) -> ())(frag);
					}
				}
			}
			elif(self.commands.tag == :ecs_remove)
			{
				let c<cmd_entity_tid_r*> = self.commands.payload ~~> cmd_entity_tid_r*;

				constif(__glc_ecs_checks)
				{
					if(!self.registry.valid?(c.e))
					{
						error.runtime_error("ecs: deferred remove! targets a dead entity");
					}
				}

				let removed<atom> = self.remove_tid!(c.e, c.tid);
			}
			elif(self.commands.tag == :ecs_tag)
			{
				let c<cmd_entity_tid_r*> = self.commands.payload ~~> cmd_entity_tid_r*;

				constif(__glc_ecs_checks)
				{
					if(!self.registry.valid?(c.e))
					{
						error.runtime_error("ecs: deferred tag! targets a dead entity");
					}
				}

				let tagged<atom> = self.tag_tid!(c.e, c.tid);
			}
			elif(self.commands.tag == :ecs_untag)
			{
				let c<cmd_entity_tid_r*> = self.commands.payload ~~> cmd_entity_tid_r*;

				constif(__glc_ecs_checks)
				{
					if(!self.registry.valid?(c.e))
					{
						error.runtime_error("ecs: deferred untag! targets a dead entity");
					}
				}

				let untagged<atom> = self.untag_tid!(c.e, c.tid);
			}
		}

		self.commands.reset!;
		self.in_tick = was_in_tick;
		^ ();
	}

	# Tears down everything: unflushed commands dispose their payloads,
	# processor instances dispose next (they may reference world data),
	# then each archetype disposes its live cells, the map disposes its
	# owned keys, the registry frees the ledger.
	- dispose -> ()
	{
		self.commands.dispose;

		if(!nil?(self.processor_instances))
		{
			__glc_ecs_dispose_processors(self.processor_instances);
			allocator_free(self.alloc, self.processor_instances);
			self.processor_instances = nil;
		}

		self.archetypes.dispose;
		self.tids_by_arch.dispose;
		self.archetype_map.dispose;
		self.registry.dispose;
		^ ();
	}
}

# Create a world with the empty archetype registered at index 0.
++ make_world() -> world_r
{
	let result<world_r>;
	result.alloc = ctx.main;
	result.registry = make_registry();
	result.archetypes = make_array(archetype_r, 4_sz);
	result.tids_by_arch = make_array([typeid, :dynamic], 4_sz);
	result.archetype_map = make_hashmap_with_capacity([c1], u4, 8_sz);
	result.commands = make_push_buffer(0_sz);

	let empty_schema<[fragment_info_r, :dynamic]> = make_array(fragment_info_r, 0_sz);
	let empty_tids<[typeid, :dynamic]> = make_array(typeid, 0_sz);
	let empty_tags<[typeid, :dynamic]> = make_array(typeid, 0_sz);
	result.find_or_create!(empty_tids, empty_tags, empty_schema.view);
	empty_schema.dispose;

	# Processor instances: allocate the compiler-reported block from the
	# world's allocator at the reported alignment, then default-construct
	# every instance.
	let (isize<size>, ialign<size>) = __glc_ecs_processor_instances_size();

	if(isize > 0_sz)
	{
		result.processor_instances = allocator_alloc_aligned(result.alloc, isize, ialign);
		__glc_ecs_init_processors(result.processor_instances);
	}

	^ result;
}
