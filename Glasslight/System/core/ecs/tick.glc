package ecs;
require core.common ~> .;

# True when the archetype satisfies the processor's query: every required
# tag present, no excluded tag present, and every fragment the processor
# reads or writes a column. Tags match by mask - the archetype's tag_mask
# folds its tags to ecs.tags() bit positions (computed once at creation),
# and the query's required/excluded masks were folded the same way at
# compile time - so the tag half is two ANDs, no list walking.
+ query_matches?(arch<archetype_r*>, info<processor_info_r>) -> atom
{
	if((arch.tag_mask & info.required_mask) != info.required_mask)
	{
		^ :false;
	}

	if((arch.tag_mask & info.excluded_mask) != 0_u8)
	{
		^ :false;
	}

	for(let i<size> = 0_sz; i < info.reads.length(); i += 1_sz)
	{
		if(!arch.has_index?(info.reads.at(i)))
		{
			^ :false;
		}
	}

	for(let i<size> = 0_sz; i < info.writes.length(); i += 1_sz)
	{
		if(!arch.has_index?(info.writes.at(i)))
		{
			^ :false;
		}
	}

	^ :true;
}

# The single-threaded tick: walks the emitted schedule stage by stage, and
# for each processor matches its emitted query against the world's
# archetypes, builds the per-chunk context, and dispatches to the
# processor's per-world instance. Consumes only emitted data plus the
# dispatch seam - no per-program knowledge.
#
# Within a stage, processors run sequentially in stage order; a stage's
# processors are conflict-free by construction, so the order is
# unobservable (running them concurrently is a later slice). A phase change
# between stages is the band boundary: deferred structural commands
# (recorded through the chunk's verbs) flush there and at tick end, so a
# band's structural effects are visible to the next band within the same
# tick. Execute bodies never structurally change the world directly - the
# chunk's views are borrows into the archetype.
#
# With no processors, or under --no-ecs, the schedule is empty and the
# tick is a no-op.
++ tick(w<world_r*>, dt<f4>) -> ()
{
	let sched<schedule_r> = schedule();
	let procs<[processor_info_r, ()]> = processors();

	w.in_tick = :true;
	let prev_phase<typeid>;

	for(let si<size> = 0_sz; si < sched.stages.length(); si += 1_sz)
	{
		let stage<stage_r> = sched.stages.at(si);

		# A phase change between stages is the band boundary - flush the
		# deferred commands so this band sees the previous band's effects.
		if(si > 0_sz && !(stage.phase == prev_phase))
		{
			w.flush_commands!;
		}

		prev_phase = stage.phase;

		for(let pi<size> = 0_sz; pi < stage.procs.length(); pi += 1_sz)
		{
			let index<u4> = stage.procs.at(pi);
			let info<processor_info_r> = procs.at(index ~> u8 ~~> size);

			for(let ai<size> = 0_sz; ai < w.archetype_count; ai += 1_sz)
			{
				let arch<archetype_r*> = w.arch_at(ai ~~> u8 ~> u4);

				if(arch.empty? || !query_matches?(arch, info))
				{
					next;
				}

				let ectx<exec_ctx_r>;
				ectx.dt = dt;
				ectx.arch = arch;
				ectx.entities = make_view(entity, arch.entities ~~> entity*, arch.length);
				ectx.ctx = ctx;
				ectx.info = info;
				ectx.checked = :true;
				ectx.w = w;
				dispatch(w, index, ectx);
			}
		}
	}

	w.flush_commands!;
	w.in_tick = :false;
	^ ();
}
