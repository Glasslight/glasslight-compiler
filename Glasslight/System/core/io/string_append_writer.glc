package io;
require core.common ~> .;
require core.string ~> .;

# Dispatch function for writers that append into a string.
+ string_append_writer_func(op<writer_op_e>, user_data<voidptr>, buf<voidptr>, count<size>) -> (size, io_error_e)
{
	match(op)
	{
		case :write =>
		{
			let out<[c1]*> = user_data ~~> [c1]*;
			out.append!(make_view(c1, buf ~~> c1*, count));
			^ (count, :ok);
		}

		case :flush =>
		{
			^ (0_sz, :ok);
		}

		case :close =>
		{
			^ (0_sz, :ok);
		}
	}

	^ (0_sz, :invalid_input);
}

# Create a writer that appends bytes into a string.
+ string_append_writer(out<[c1]*>) -> writer_r
{
	let w<writer_r>;
	w.func = &string_append_writer_func;
	w.user_data = out ~~> voidptr;

	^ w;
}
