package view;
require core.basic ~> .;
require core.basic.limits ~> .;

record view_r<$t<typeid> >
{
	let data<t*> = nil;
	let length<size> = 0_sz;

	# Returns the runtime length of the view.
	- length() -> size { ^ self.length; }

	# Returns the value at the requested index.
	- at(idx<size>) -> t { ^ *(self.data + idx); }

	# Returns the value at the requested index via subscript syntax.
	- subscript(idx<size>) -> t { ^ *(self.data + idx); }

	# Returns the start pointer for the viewed data.
	- data() -> t* { ^ self.data; }

	# Returns whether the given index is within bounds.
	- valid_index?(idx<size>) when idx < self.length -> atom { ^ :true; }
	- valid_index?(idx<size>) -> atom { ^ :false; }

	# Returns whether the view has no elements.
	- empty? when self.length == 0_sz -> atom { ^ :true; }
	- empty? -> atom { ^ :false; }

	constif(comparable?(t))
	{
		# Return an index of a given value.
		- index_of(v<t>) -> (atom, size)
		{
			for(let i<size> = 0_sz; i < self.length; i += 1_sz)
			{
				let e<t> = *(self.data + i);

				if(e == v)
				{
					^ (:true, i);
				}
			}

			^ (:false, max(size));
		}

		# Return :true if view contains a given element.
		- contains?(e<t>) -> atom
		{
			let (ok<atom>, _) = self.index_of(e);
			^ ok;
		}
	}

	# Return first element.
	- first -> t { ^ *(self.data + 0_sz); }

	# Return last element.
	- last -> t { ^ *(self.data + self.length - 1_sz); }

	# Return top/last element.
	- top -> t { ^ *(self.data + self.length - 1_sz); }

	# Return a sub-view starting at start with length count.
	- slice(start<size>, count<size>) -> (atom, [t, ()])
	{
		if(start + count > self.length)
		{
			^ (:false, make_view(t, self.data, 0_sz));
		}

		^ (:true, make_view(t, self.data + start, count));
	}

	# Alias for slice.
	- mid(start<size>, count<size>) -> (atom, [t, ()]) { ^ self.slice(start, count); }

	# Return a sub-view from start to the end.
	- mid(start<size>) -> (atom, [t, ()])
	{
		if(start > self.length)
		{
			^ (:false, make_view(t, self.data, 0_sz));
		}

		^ (:true, make_view(t, self.data + start, self.length - start));
	}

	# Return the first count elements.
	- left(count<size>) -> (atom, [t, ()]) { ^ self.slice(0_sz, count); }

	# Return the last count elements.
	- right(count<size>) -> (atom, [t, ()])
	{
		if(count > self.length)
		{
			^ (:false, make_view(t, self.data, 0_sz));
		}

		^ (:true, make_view(t, self.data + self.length - count, count));
	}

	# Drop first count elements, return rest.
	- left_chop(count<size>) -> (atom, [t, ()]) { ^ self.mid(count); }

	# Drop last count elements, return rest.
	- right_chop(count<size>) -> (atom, [t, ()])
	{
		if(count > self.length)
		{
			^ (:false, make_view(t, self.data, 0_sz));
		}

		^ (:true, make_view(t, self.data, self.length - count));
	}

	# Advance the view position by s elements. Returns empty view if s exceeds length.
	- advance(s<size>) when s < self.length -> [t, ()]
	{
		^ make_view(t, self.data + s, self.length - s);
	}
	- advance(s<size>) -> [t, ()]
	{
		^ make_view(t, self.data, 0_sz);
	}

	constif(comparable?(t))
	{
		# Check if view equals another view element-by-element.
		- equals?(other<[t, ()]>) -> atom
		{
			if(self.length != other.length())
			{
				^ :false;
			}

			for(let i<size> = 0_sz; i < self.length; i += 1_sz)
			{
				if(*(self.data + i) != *(other.data() + i))
				{
					^ :false;
				}
			}

			^ :true;
		}
	}

	constif(t == typeof c1)
	{
		# Find a single byte (alias for index_of).
		- find(v<t>) -> (atom, size) { ^ self.index_of(v); }

		# Return last index of a given byte value (reverse search).
		- last_index_of(v<t>) -> (atom, size)
		{
			for(let i<size> = self.length; i > 0_sz; i -= 1_sz)
			{
				if(*(self.data + i - 1_sz) == v)
				{
					^ (:true, i - 1_sz);
				}
			}

			^ (:false, max(size));
		}

		# Find last occurrence of a byte (alias for last_index_of).
		- find_last(v<t>) -> (atom, size) { ^ self.last_index_of(v); }

		# Find first occurrence of a substring needle.
		- index_of(needle<[t, ()]>) -> (atom, size)
		{
			let needle_len<size> = needle.length();

			if(needle_len == 0_sz)
			{
				^ (:true, 0_sz);
			}

			if(needle_len > self.length)
			{
				^ (:false, max(size));
			}

			let limit<size> = self.length - needle_len + 1_sz;

			for(let i<size> = 0_sz; i < limit; i += 1_sz)
			{
				let matched<atom> = :true;

				for(let j<size> = 0_sz; j < needle_len; j += 1_sz)
				{
					if(*(self.data + i + j) != *(needle.data() + j))
					{
						matched = :false;
						j = needle_len;
					}
				}

				if(matched == :true)
				{
					^ (:true, i);
				}
			}

			^ (:false, max(size));
		}

		# Find first occurrence of a substring (alias for index_of).
		- find(needle<[t, ()]>) -> (atom, size) { ^ self.index_of(needle); }

		# Find last occurrence of a substring needle (reverse search).
		- last_index_of(needle<[t, ()]>) -> (atom, size)
		{
			let needle_len<size> = needle.length();

			if(needle_len == 0_sz)
			{
				^ (:true, self.length);
			}

			if(needle_len > self.length)
			{
				^ (:false, max(size));
			}

			let limit<size> = self.length - needle_len + 1_sz;

			for(let i<size> = limit; i > 0_sz; i -= 1_sz)
			{
				let pos<size> = i - 1_sz;
				let matched<atom> = :true;

				for(let j<size> = 0_sz; j < needle_len; j += 1_sz)
				{
					if(*(self.data + pos + j) != *(needle.data() + j))
					{
						matched = :false;
						j = needle_len;
					}
				}

				if(matched == :true)
				{
					^ (:true, pos);
				}
			}

			^ (:false, max(size));
		}

		# Find last occurrence of a substring (alias for last_index_of).
		- find_last(needle<[t, ()]>) -> (atom, size) { ^ self.last_index_of(needle); }

		# Return :true if view contains a given substring.
		- contains?(needle<[t, ()]>) -> atom
		{
			let (ok<atom>, _) = self.index_of(needle);
			^ ok;
		}

		# Check if view starts with a given byte.
		- starts_with?(b<t>) when self.length == 0_sz -> atom { ^ :false; }
		- starts_with?(b<t>) -> atom
		{
			^ *(self.data) == b;
		}

		# Check if view starts with a given prefix.
		- starts_with?(prefix<[t, ()]>) -> atom
		{
			if(prefix.length() > self.length)
			{
				^ :false;
			}

			for(let i<size> = 0_sz; i < prefix.length(); i += 1_sz)
			{
				if(*(self.data + i) != *(prefix.data() + i))
				{
					^ :false;
				}
			}

			^ :true;
		}

		# Check if view ends with a given byte.
		- ends_with?(b<t>) when self.length == 0_sz -> atom { ^ :false; }
		- ends_with?(b<t>) -> atom
		{
			^ *(self.data + self.length - 1_sz) == b;
		}

		# Check if view ends with a given suffix.
		- ends_with?(suffix<[t, ()]>) -> atom
		{
			if(suffix.length() > self.length)
			{
				^ :false;
			}

			let offset<size> = self.length - suffix.length();

			for(let i<size> = 0_sz; i < suffix.length(); i += 1_sz)
			{
				if(*(self.data + offset + i) != *(suffix.data() + i))
				{
					^ :false;
				}
			}

			^ :true;
		}

		# Lexicographic comparison returning compare_result_e.
		- compare(other<[t, ()]>) -> compare_result_e
		{
			let self_len<size> = self.length;
			let other_len<size> = other.length();
			let min_len<size> = self_len;

			if(other_len < self_len)
			{
				min_len = other_len;
			}

			for(let i<size> = 0_sz; i < min_len; i += 1_sz)
			{
				let a<t> = *(self.data + i);
				let b<t> = *(other.data() + i);

				if(a < b)
				{
					^ :less;
				}

				if(a > b)
				{
					^ :greater;
				}
			}

			if(self_len < other_len)
			{
				^ :less;
			}

			if(self_len > other_len)
			{
				^ :greater;
			}

			^ :equal;
		}
	}
}

# Creates an unsized view from a pointer and length.
+ make_view($t<typeid>, ptr<t*>, length<size>) -> [t, ()]
{
	let result<[t, ()]>;
	result.data = ptr;
	result.length = length;

	^ result;
}

# Make an unsized empty view.
+ make_empty_view($t<typeid>, ptr<t*>) -> [t, ()]
{
	^ make_view(ptr, 0_sz);
}
