package view;
require core.basic ~> .;
require core.basic.limits ~> .;

record view_r<$t<typeid>, $n<size> >
{
	let data<t*> = nil;

	# Returns the compile-time length of the view.
	- length -> size { ^ n; }

	# Returns the value at the requested index.
	- at(idx<size>) -> t { ^ *(self.data + idx); }

	# Returns the value at the requested index via subscript syntax.
	- subscript(idx<size>) -> t { ^ *(self.data + idx); }

	# Returns the start pointer for the viewed data.
	- data() -> t* { ^ self.data; }

	# Returns whether the given index is within bounds.
	- valid_index?(idx<size>) when idx < n -> atom { ^ :true; }
	- valid_index?(idx<size>) -> atom { ^ :false; }

	# Sized views are never empty.
	- empty? -> atom { ^ :false; }

	constif(comparable?(t))
	{
		# Return an index of a given value.
		- index_of(v<t>) -> (atom, size)
		{
			for(let i<size> = 0_sz; i < n; i += 1_sz)
			{
				let e<t> = *(self.data + i);

				if(e == v)
				{
					^ (:true, i);
				}
			}

			^ (:false, max(size));
		}

		# Return :true if view contains a given element.
		- contains?(e<t>) -> atom
		{
			let (ok<atom>, _) = self.index_of(e);
			^ ok;
		}
	}

	# Return first element.
	- first -> t { ^ *(self.data + 0_sz); }

	# Return last element.
	- last -> t { ^ *(self.data + n - 1_sz); }

	# Return top/last element.
	- top -> t { ^ *(self.data + n - 1_sz); }

	# Returns an equivalent unsized view over the same data.
	- view -> [t, ()] { ^ make_view(t, self.data, n); }

	# Return a sub-view starting at start with length count.
	- slice(start<size>, count<size>) -> (atom, [t, ()]) { ^ self.view.slice(start, count); }

	# Alias for slice.
	- mid(start<size>, count<size>) -> (atom, [t, ()]) { ^ self.view.mid(start, count); }

	# Return a sub-view from start to the end.
	- mid(start<size>) -> (atom, [t, ()]) { ^ self.view.mid(start); }

	# Return the first count elements.
	- left(count<size>) -> (atom, [t, ()]) { ^ self.view.left(count); }

	# Return the last count elements.
	- right(count<size>) -> (atom, [t, ()]) { ^ self.view.right(count); }

	# Drop first count elements, return rest.
	- left_chop(count<size>) -> (atom, [t, ()]) { ^ self.view.left_chop(count); }

	# Drop last count elements, return rest.
	- right_chop(count<size>) -> (atom, [t, ()]) { ^ self.view.right_chop(count); }

	constif(comparable?(t))
	{
		# Check if view equals another view element-by-element.
		- equals?(other<[t, ()]>) -> atom { ^ self.view.equals?(other); }
	}

	constif(t == typeof c1)
	{
		# Find a single byte (alias for index_of).
		- find(v<t>) -> (atom, size) { ^ self.view.find(v); }

		# Return last index of a given byte value.
		- last_index_of(v<t>) -> (atom, size) { ^ self.view.last_index_of(v); }

		# Find last occurrence of a byte (alias for last_index_of).
		- find_last(v<t>) -> (atom, size) { ^ self.view.find_last(v); }

		# Find first occurrence of a substring needle.
		- index_of(needle<[t, ()]>) -> (atom, size) { ^ self.view.index_of(needle); }

		# Find first occurrence of a substring (alias for index_of).
		- find(needle<[t, ()]>) -> (atom, size) { ^ self.view.find(needle); }

		# Find last occurrence of a substring needle.
		- last_index_of(needle<[t, ()]>) -> (atom, size) { ^ self.view.last_index_of(needle); }

		# Find last occurrence of a substring (alias for last_index_of).
		- find_last(needle<[t, ()]>) -> (atom, size) { ^ self.view.find_last(needle); }

		# Return :true if view contains a given substring.
		- contains?(needle<[t, ()]>) -> atom { ^ self.view.contains?(needle); }

		# Check if view starts with a given byte.
		- starts_with?(b<t>) -> atom { ^ self.view.starts_with?(b); }

		# Check if view starts with a given prefix.
		- starts_with?(prefix<[t, ()]>) -> atom { ^ self.view.starts_with?(prefix); }

		# Check if view ends with a given byte.
		- ends_with?(b<t>) -> atom { ^ self.view.ends_with?(b); }

		# Check if view ends with a given suffix.
		- ends_with?(suffix<[t, ()]>) -> atom { ^ self.view.ends_with?(suffix); }

		# Lexicographic comparison returning compare_result_e.
		- compare(other<[t, ()]>) -> compare_result_e { ^ self.view.compare(other); }
	}
}

# Creates a sized view from a pointer.
+ make_view($t<typeid>, $n<size>, ptr<t*>) -> [t, (n,)]
{
	let result<[t, (n,)]>;
	result.data = ptr;

	^ result;
}
