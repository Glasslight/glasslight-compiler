package thread;

require core.basic ~> .;
require core.context ~> .;
require core.allocator ~> .;
require core.wstring ~> .;
require core.unicode.wstring ~> uwstr;
require core.platform.win.kernel32 ~> kernel32;

record thread_r
{
	let native<u8>;
}

record thread_spawn_config_r
{
	let name<[c1, :c]> = nil;
	let stack_bytes<size> = 0_sz;
}

record thread_args_r
{
	let ctx<context_r>;
	let entry<(context_r, voidptr) -> ()>;
	let user_data<voidptr>;
	let args_alloc<allocator_r>;
}

[[:system, :dynamic]]
foreign "Kernel32" ~> .
{
	# Create a new thread running `lpStartAddress(lpParameter)`. Returns HANDLE or nil on failure.
	+ CreateThread(lpThreadAttributes<voidptr>, dwStackSize<size>, lpStartAddress<fptr>, lpParameter<voidptr>, dwCreationFlags<u4>, lpThreadId<u4*>) -> kernel32.handle_t;

	# Return a pseudo-handle for the calling thread.
	+ GetCurrentThread -> kernel32.handle_t;

	# Terminate the calling thread with the given exit code.
	+ ExitThread(dwExitCode<u4>) -> ();

	# Yield to another ready thread on the same processor.
	+ SwitchToThread -> cbool ->> atom;

	# Return the calling thread's numeric id (DWORD).
	+ GetCurrentThreadId -> u4;

	# Return the numeric id (DWORD) of the thread referenced by `handle`.
	+ GetThreadId(handle<kernel32.handle_t>) -> u4;

	# Set the description (name) of `handle`. Takes a NUL-terminated UTF-16LE wide string. Returns S_OK (0) on success.
	+ SetThreadDescription(handle<kernel32.handle_t>, description<c2*>) -> s4;

	# Set the CPU affinity mask for `handle`. Returns the previous mask, or 0 on failure.
	+ SetThreadAffinityMask(handle<kernel32.handle_t>, dwThreadAffinityMask<size>) -> size;
}

# Win32 entry trampoline: `+` so the OS can call it. Installs ctx from args in
# scope, frees the args buffer, and calls the user entry — that call
# auto-injects ctx from this scope. Returns DWORD (u4) to match
# LPTHREAD_START_ROUTINE.
+ __glc_thread_bootstrap_win64(raw<voidptr>) -> u4
{
	let args<thread_args_r*> = raw ~~> thread_args_r*;
	let ctx<context_r> = args.ctx;
	let entry<(context_r, voidptr) -> ()> = args.entry;
	let user_data<voidptr> = args.user_data;
	let args_alloc<allocator_r> = args.args_alloc;

	allocator_free(args_alloc, raw);
	entry(user_data);
	^ 0_u4;
}

# Spawn a worker thread running `entry(ctx, user_data)` with the given config.
++ spawn(config<thread_spawn_config_r>, entry<(context_r, voidptr) -> ()>, user_data<voidptr>) -> (atom, thread_r)
{
	let a<allocator_r> = ctx.main;
	let raw<voidptr> = allocator_alloc(a, typeinfo(thread_args_r, :bytes));
	let args<thread_args_r*> = raw ~~> thread_args_r*;
	args.ctx = ctx;
	args.entry = entry;
	args.user_data = user_data;
	args.args_alloc = a;

	let handle<kernel32.handle_t> = CreateThread(nil, config.stack_bytes, &__glc_thread_bootstrap_win64 ~> fptr, raw, 0_u4, nil);

	if(nil?(handle))
	{
		allocator_free(a, raw);
		let failed<thread_r>;
		^ (:failed, failed);
	}

	let t<thread_r>;
	t.native = handle ~~> u8;
	^ (:ok, t);
}

# Spawn a worker thread with the default config (no name, OS-default stack).
++ spawn_default(entry<(context_r, voidptr) -> ()>, user_data<voidptr>) -> (atom, thread_r)
{
	let config<thread_spawn_config_r>;
	^ spawn(config, entry, user_data);
}

# Block until thread `t` exits, then close its handle. Returns :ok or :failed.
+ join(t<thread_r>) -> atom
{
	let handle<kernel32.handle_t> = t.native ~~> kernel32.handle_t;
	let wait_result<u4> = kernel32.WaitForSingleObject(handle, kernel32.INFINITE);

	if(wait_result != kernel32.WAIT_OBJECT_0)
	{
		^ :failed;
	}

	let closed<atom> = kernel32.CloseHandle(handle);

	if(closed)
	{
		^ :ok;
	}

	^ :failed;
}

# Detach by closing the thread handle; the thread keeps running until exit.
+ detach(t<thread_r>) -> atom
{
	let handle<kernel32.handle_t> = t.native ~~> kernel32.handle_t;
	^ kernel32.CloseHandle(handle);
}

# Return a pseudo-handle for the calling thread.
+ current -> thread_r
{
	let handle<kernel32.handle_t> = GetCurrentThread;
	let t<thread_r>;
	t.native = handle ~~> u8;
	^ t;
}

# Hint to the scheduler to run another ready thread.
+ yield_now -> ()
{
	let _r<atom> = SwitchToThread;
	^ ();
}

# Terminate the calling thread immediately with exit code 0.
+ exit_thread -> ()
{
	ExitThread(0_u4);
	^ ();
}

# Return the numeric thread id of `t`.
+ thread_id(t<thread_r>) -> u8
{
	let handle<kernel32.handle_t> = t.native ~~> kernel32.handle_t;
	let id<u4> = GetThreadId(handle);
	^ id ~> u8;
}

# Return the calling thread's numeric id.
+ current_id -> u8
{
	let id<u4> = GetCurrentThreadId;
	^ id ~> u8;
}

# Return :true if `a` and `b` refer to the same thread, :false otherwise.
# Win32 HANDLEs may differ for the same thread (DuplicateHandle); compare numeric ids.
+ thread_equal(a<thread_r>, b<thread_r>) -> atom
{
	let ha<kernel32.handle_t> = a.native ~~> kernel32.handle_t;
	let hb<kernel32.handle_t> = b.native ~~> kernel32.handle_t;
	let id_a<u4> = GetThreadId(ha);
	let id_b<u4> = GetThreadId(hb);

	if(id_a == id_b)
	{
		^ :true;
	}

	^ :false;
}

# Set the calling thread's name. Returns :ok or :failed.
++ thread_set_name(name<[c1, :c]>) -> atom
{
	let wide<[c2]> = uwstr.make_from_utf8(name.view);
	let handle<kernel32.handle_t> = GetCurrentThread;
	let hr<s4> = SetThreadDescription(handle, wide.data);
	wide.delete;

	if(hr >= 0_s4)
	{
		^ :ok;
	}

	^ :failed;
}

# Return the number of logical processors on the system.
+ hardware_concurrency -> u4
{
	let info<kernel32.SYSTEM_INFO_r>;
	kernel32.GetSystemInfo(&info);

	if(info.dwNumberOfProcessors < 1_u4)
	{
		^ 1_u4;
	}

	^ info.dwNumberOfProcessors;
}

# Set the CPU affinity mask for thread `t` (low 64 CPUs). Returns :ok or :failed.
+ thread_set_affinity_mask(t<thread_r>, mask<u8>) -> atom
{
	let handle<kernel32.handle_t> = t.native ~~> kernel32.handle_t;
	let prev<size> = SetThreadAffinityMask(handle, mask ~~> size);

	if(prev != 0_sz)
	{
		^ :ok;
	}

	^ :failed;
}

# Query the CPU affinity mask for thread `t`. Win32 has no direct getter, so
# temporarily set to the process mask, capture the returned previous mask,
# and restore it. Returns (:ok, mask) or (:failed, 0_u8).
+ thread_get_affinity_mask(t<thread_r>) -> (atom, u8)
{
	let process<kernel32.handle_t> = kernel32.GetCurrentProcess;
	let proc_mask<size> = 0_sz;
	let sys_mask<size> = 0_sz;
	let ok<atom> = kernel32.GetProcessAffinityMask(process, &proc_mask, &sys_mask);

	if(ok != :true)
	{
		^ (:failed, 0_u8);
	}

	let handle<kernel32.handle_t> = t.native ~~> kernel32.handle_t;
	let prev<size> = SetThreadAffinityMask(handle, proc_mask);

	if(prev == 0_sz)
	{
		^ (:failed, 0_u8);
	}

	let _restore<size> = SetThreadAffinityMask(handle, prev);
	^ (:ok, prev ~~> u8);
}
