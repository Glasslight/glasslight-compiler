package hash;
require core.common ~> .;
require core.atom ~> .;
require core.array ~> .;
require core.math ~> math;

intrinsic
{
	+ __glc_hash_typeid(v<typeid>) -> hash;
}

# Zero hash.
+ hash_zero -> hash { ^ 0_hs; }

# Combine two hashes.
+ hash_combine(lhs<hash>, rhs<hash>) -> hash
{
	^ lhs $ (rhs + 0x9e3779b97f4a7c15_hs + (lhs << 6_sz) + (lhs >> 2_sz));
}

# Basic type hashing.
+ hashing(v<hash>) -> hash { ^ v; }
+ hashing(v<size>) -> hash { ^ v ~~> hash; }
+ hashing(v<voidptr>) -> hash { ^ hash_bits(v); }
+ hashing(v<atom>) -> hash { ^ v ~> hash; }
+ hashing(v<typeid>) -> hash { ^ __glc_hash_typeid(v); }
+ hashing(v<entity>) -> hash { ^ v ~~> hash; }

# Hashing for unsigned integers.
+ hashing(v<u1>) -> hash { ^ v ~> hash; }
+ hashing(v<u2>) -> hash { ^ v ~> hash; }
+ hashing(v<u4>) -> hash { ^ v ~> hash; }
+ hashing(v<u8>) -> hash { ^ v ~~> hash; }

# Hashing for signed integers.
+ hashing(v<s1>) -> hash { ^ v ~> hash; }
+ hashing(v<s2>) -> hash { ^ v ~> hash; }
+ hashing(v<s4>) -> hash { ^ v ~> hash; }
+ hashing(v<s8>) -> hash { ^ v ~> hash; }

# Hashing for characters.
+ hashing(v<c1>) -> hash { ^ hash_bits(v ~> u1); }
+ hashing(v<c2>) -> hash { ^ hash_bits(v ~> u2); }
+ hashing(v<c4>) -> hash { ^ hash_bits(v ~> u4); }

# Hashing for 16 bit floats.
+ hashing(v<f2>) when math.nan?(v) -> hash { ^ hash_bits(0x7e00_u2); }
+ hashing(v<f2>) when v == 0.0_f2 -> hash { ^ hash_zero; }
+ hashing(v<f2>) -> hash { ^ hash_bits(v); }

# Hashing for 32 bit floats.
+ hashing(v<f4>) when math.nan?(v) -> hash { ^ hash_bits(0x7fc00000_u4); }
+ hashing(v<f4>) when v == 0.0_f4 -> hash { ^ hash_zero; }
+ hashing(v<f4>) -> hash { ^ hash_bits(v); }

# Hashing for 64 bit floats.
+ hashing(v<f8>) when math.nan?(v) -> hash { ^ hash_bits(0x7ff8000000000000_u8); }
+ hashing(v<f8>) when v == 0.0_f8 -> hash { ^ hash_zero; }
+ hashing(v<f8>) -> hash { ^ hash_bits(v); }

# Tuple hashing.
+ hashing($t<typeid>, v<t>) when tuple?(t) && hashable?(t) && empty?(t) -> hash { ^ hash_zero; }
+ hashing($t<typeid>, v<t>) when tuple?(t) && hashable?(t) && !empty?(t) -> hash
{
	let head<hash> = hashing(car(v));
	let tail<hash> = hashing(cdr(v));
	^ hash_combine(head, tail);
}

# Unsized view hashing.
+ hashing($e<typeid>, v<[e, ()]>) when hashable?(e) && e != typeof c1 -> hash
{
	let result<hash> = hash_zero;
	for(let idx<size> = 0_sz; idx < v.length(); idx += 1_sz)
	{
		let element_hash<hash> = hashing(v[idx]);
		result = hash_combine(result, element_hash);
	}

	^ result;
}
+ hashing($e<typeid>, v<[e, ()]>) when hashable?(e) && e == typeof c1 -> hash
{
	^ hash_bits(v);
}

# Viewable collection hashing.
+ hashing($t<typeid>, v<t>) when collection?(t) && viewable?(t) && hashable?(typeinfo(t, :element)) -> hash
{
	const e<typeid> = typeinfo(t, :element);
	let view<[e, ()]> = v.view;
	^ hashing(view);
}

# Record hashing.
+ hashing($t<typeid>, v<t>) when record?(t) && hashable?(t) -> hash { ^ v.hashing; }
