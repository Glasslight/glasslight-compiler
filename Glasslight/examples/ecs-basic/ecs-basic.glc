package main;
require core.common ~> .;
require core.array ~> .;
require core.string ~> .;
require core.format ~> fmt;
require core.os.print ~> os;
require core.ecs ~> ecs;

# The intro ECS example, fully declarative: fragments and a tag describe
# the data, processors declare their queries and ordering, and the program
# is spawns plus ecs.tick calls. The compiler validates the graph at
# compile time, emits the schedule and query tables, and generates the
# dispatch; the generic runtime consumes them as plain data.

# Plain-data fragments: no lifecycle, no dispose, zero overhead.
[[:fragment]]
record pos_r
{
	let x<s4> = 0_s4;
	let y<s4> = 0_s4;
}

[[:fragment]]
record vel_r
{
	let dx<s4> = 0_s4;
	let dy<s4> = 0_s4;
}

# An owning fragment: the name owns a heap string, so the compiler requires
# this dispose - and the world calls it automatically when the creature dies
# or the world tears down. No cleanup code appears anywhere below.
[[:fragment]]
record name_r
{
	let name<[c1]>;
	- dispose -> ()
	{
		self.name.dispose;
		^ ();
	}
}

# A tag: an empty declared type that is part of archetype identity but
# occupies no storage. Misspelling a tag is a compile error, not a silent
# new archetype - and processor queries match on it below.
[[:tag]]
record fast_tag_r
{
}

[[:phase]]
record step_phase_r
{
}

# The integration step as a processor: the query (read vel, write pos) is
# declared, matching archetypes arrive as chunks, and the body is a tight
# SoA loop through typed views - no per-entity lookups.
[[:processor]]
[[(:ecs_read, vel_r)]]
[[(:ecs_write, pos_r)]]
[[(:ecs_phase, step_phase_r)]]
record move_processor_r
{
	- execute(ectx<ecs.exec_ctx_r>) -> ()
	{
		let ps<[pos_r, (), :mut]> = ectx.write(pos_r);
		let vs<[vel_r, ()]> = ectx.read(vel_r);

		for(let i<size> = 0_sz; i < ectx.length; i += 1_sz)
		{
			ps[i].x += vs[i].dx;
			ps[i].y += vs[i].dy;
		}

		^ ();
	}
}

# Tag matching: fast creatures take a second step each tick. The require
# means this processor only ever sees archetypes carrying fast_tag_r - the
# untagged never pay for a check.
[[:processor]]
[[(:ecs_read, vel_r)]]
[[(:ecs_write, pos_r)]]
[[(:ecs_require, fast_tag_r)]]
[[(:ecs_after, move_processor_r)]]
[[(:ecs_phase, step_phase_r)]]
record sprint_processor_r
{
	- execute(ectx<ecs.exec_ctx_r>) -> ()
	{
		let ps<[pos_r, (), :mut]> = ectx.write(pos_r);
		let vs<[vel_r, ()]> = ectx.read(vel_r);

		for(let i<size> = 0_sz; i < ectx.length; i += 1_sz)
		{
			ps[i].x += vs[i].dx;
			ps[i].y += vs[i].dy;
		}

		^ ();
	}
}

+ make_pos(x<s4>, y<s4>) -> pos_r
{
	let p<pos_r>;
	p.x = x;
	p.y = y;
	^ p;
}

+ make_vel(dx<s4>, dy<s4>) -> vel_r
{
	let v<vel_r>;
	v.dx = dx;
	v.dy = dy;
	^ v;
}

++ make_name(text<[c1, ()]>) -> name_r
{
	let n<name_r>;
	n.name = make_string(text);
	^ n;
}

++ spawn_creature(w<ecs.world_r*>, text<[c1, ()]>, x<s4>, y<s4>) -> entity
{
	let e<entity> = w.spawn!;
	w.add!(e, name_r, make_name(text));
	w.add!(e, pos_r, make_pos(x, y));
	^ e;
}

# Reporting stays a plain function: it follows entity handles across
# archetypes, which is direct-access work, not a chunked query.
++ report(w<ecs.world_r*>, creatures<[entity, ()]>) -> ()
{
	for(let i<size> = 0_sz; i < creatures.length(); i += 1_sz)
	{
		let e<entity> = creatures.at(i);

		if(!w.registry.valid?(e))
		{
			next;
		}

		let n<name_r*> = w.get(e, name_r);
		let p<pos_r*> = w.get(e, pos_r);
		let line<[c1]> = fmt.format("  {} at ({}, {})", (n.name.view, p.x, p.y));
		os.println(line);
		line.dispose;
	}

	^ ();
}

let w<ecs.world_r> = ecs.make_world();
let creatures<[entity, :dynamic]> = make_array(entity, 3_sz);

# Three creatures; two can move; the rabbit is fast - it sprints.
creatures.append!(spawn_creature(&w, "rabbit", 0_s4, 0_s4));
creatures.append!(spawn_creature(&w, "turtle", 10_s4, 5_s4));
creatures.append!(spawn_creature(&w, "rock", 20_s4, 20_s4));

w.add!(creatures.at(0_sz), vel_r, make_vel(3_s4, 1_s4));
w.add!(creatures.at(1_sz), vel_r, make_vel(1_s4, 0_s4));
w.tag!(creatures.at(0_sz), fast_tag_r);

os.println("before:");
report(&w, creatures.view);

ecs.tick(&w, 1.0_f4);

os.println("after one tick:");
report(&w, creatures.view);

# The rock erodes: its name string is disposed by the world, automatically.
w.destroy!(creatures.at(2_sz));

os.println("after the rock erodes:");
report(&w, creatures.view);

# World teardown disposes every surviving name - and the processor
# instances. No manual cleanup anywhere.
w.dispose;
creatures.dispose;
os.println("done.");
