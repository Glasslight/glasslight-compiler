package main;
require core.common ~> .;
require core.enums;
require core.string ~> .;
require core.os.print ~> os;
require core.os.argv ~> argv;

let args<[[c1], :dynamic]> = argv.argv_args;
let result<[c1]> = make_joined_string(args, " ");

os.println(result);
result.delete;

enums.each(args.view, \ (arg<[c1]>) -> ()
{
	arg.delete;
	^ ();
});

args.delete;
