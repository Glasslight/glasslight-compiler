package main;
require core.common ~> .;
require core.array ~> .;
require core.string ~> .;
require core.os.print ~> os;
require core.os.argv ~> argv;

let args<[[c1], :dynamic]> = argv.argv_args;
let result<[c1]> = make_joined_string(args, " ");

os.println(result);
result.dispose;

# args owns its element strings: dispose() disposes each element, then frees the array.
args.dispose;
