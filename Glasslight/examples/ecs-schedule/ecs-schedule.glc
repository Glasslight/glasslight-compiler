package main;
require core.common ~> .;
require core.string ~> .;
require core.context ~> .;
require core.format ~> fmt;
require core.os.print ~> os;
require core.ecs ~> ecs;

# A declarative ECS program driven entirely by the compiler and the generic
# runtime. The compiler validates the phase/processor graph at compile time
# (cycles, missing phases, cross-phase edges, access conflicts, missing
# executes are all errors), emits the schedule/query tables, and generates
# comptime dispatch to each processor's execute. ecs.tick() consumes all of
# it as plain data: this file is declarations plus tick calls.

[[:fragment]]
record pos_r
{
	let x<s4> = 0_s4;
	let y<s4> = 0_s4;
}

[[:fragment]]
record vel_r
{
	let dx<s4> = 0_s4;
	let dy<s4> = 0_s4;
}

[[:fragment]]
record age_r
{
	let ticks<s4> = 0_s4;
}

# Two bands: simulate, then render. The band boundary is where deferred
# structural changes will flush once command buffers exist.
[[:phase]]
record simulate_phase_r
{
}

[[:phase]]
[[(:ecs_after, simulate_phase_r)]]
record render_phase_r
{
}

# move and age are unordered with DISJOINT writes: the graph builder puts
# them in one parallel-eligible stage, and the disjointness is what keeps
# that legal once execution goes concurrent.
[[:processor]]
[[(:ecs_read, vel_r)]]
[[(:ecs_write, pos_r)]]
[[(:ecs_phase, simulate_phase_r)]]
record move_processor_r
{
	- execute(ctx<ecs.exec_ctx_r>) -> ()
	{
		let ps<[pos_r, (), :mut]> = ctx.write(pos_r);
		let vs<[vel_r, ()]> = ctx.read(vel_r);

		for(let i<size> = 0_sz; i < ctx.length; i += 1_sz)
		{
			ps[i].x += vs[i].dx;
			ps[i].y += vs[i].dy;
		}

		^ ();
	}
}

[[:processor]]
[[(:ecs_write, age_r)]]
[[(:ecs_phase, simulate_phase_r)]]
record age_processor_r
{
	- execute(ctx<ecs.exec_ctx_r>) -> ()
	{
		let ages<[age_r, (), :mut]> = ctx.write(age_r);

		for(let i<size> = 0_sz; i < ctx.length; i += 1_sz)
		{
			ages[i].ticks += 1_s4;
		}

		^ ();
	}
}

# Rendering formats, which allocates: the body enters the ticking caller's
# context by introducing the ctx binding from the chunk (execute itself
# runs context-free, so its parameter is named chunk to leave the name
# open).
[[:processor]]
[[(:ecs_read, pos_r)]]
[[(:ecs_phase, render_phase_r)]]
record draw_processor_r
{
	- execute(chunk<ecs.exec_ctx_r>) -> ()
	{
		let ctx<context_r> = chunk.ctx;
		let ps<[pos_r, ()]> = chunk.read(pos_r);

		for(let i<size> = 0_sz; i < chunk.length; i += 1_sz)
		{
			let line<[c1]> = fmt.format("  entity {} at ({}, {})", (ecs.index(chunk.entities[i]), ps[i].x, ps[i].y));
			os.println(line);
			line.dispose;
		}

		^ ();
	}
}

++ spawn_mover(w<ecs.world_r*>, x<s4>, y<s4>, dx<s4>, dy<s4>) -> ()
{
	let e<entity> = w.spawn!;
	let p<pos_r>;
	p.x = x;
	p.y = y;
	w.add!(e, pos_r, p);
	let v<vel_r>;
	v.dx = dx;
	v.dy = dy;
	w.add!(e, vel_r, v);
	let a<age_r>;
	w.add!(e, age_r, a);
	^ ();
}

let w<ecs.world_r> = ecs.make_world();

# Two movers, and a landmark with a position but no velocity: move skips it
# (its archetype fails the vel_r query), draw still renders it.
spawn_mover(&w, 0_s4, 0_s4, 3_s4, 1_s4);
spawn_mover(&w, 10_s4, 5_s4, 1_s4, 0_s4);

let landmark<entity> = w.spawn!;
let lp<pos_r>;
lp.x = 20_s4;
lp.y = 20_s4;
w.add!(landmark, pos_r, lp);

os.println("tick 1:");
ecs.tick(&w, 1.0_f4);

os.println("tick 2:");
ecs.tick(&w, 1.0_f4);

w.dispose;
os.println("done.");
